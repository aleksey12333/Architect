<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AIArchitectStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Кисти темы: ThemeService мутирует их Color, поэтому весь UI перекрашивается мгновенно. Начальные значения = Cupertino Dark. -->
            <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#0D0D10" />
            <SolidColorBrush x:Key="PanelBrush" Color="#D81C1C1E" />
            <SolidColorBrush x:Key="CardBrush" Color="#2C2C2E" />
            <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="PillBrush" Color="#5C5C60" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E0A84FF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E93" />
            <SolidColorBrush x:Key="StudioBorderBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="GridMinorBrush" Color="#1A1A1F" />
            <SolidColorBrush x:Key="GridMajorBrush" Color="#2C2C33" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="UserBubbleBrush" Color="#2E0A84FF" />
            <SolidColorBrush x:Key="AssistantBubbleBrush" Color="#2C2C2E" />

            <!-- Матовое стекло парящих островов (in-app acrylic размывает 3D-холст под панелью) -->
            <AcrylicBrush x:Key="IslandBrush" TintColor="#1C1C1E" TintOpacity="0.7" TintLuminosityOpacity="0.9" FallbackColor="#1C1C1E" />
            <!-- Лёгкое стекло (лента «Коллоквиум ИИ»): тот же оттенок темы, вдвое прозрачнее, без обводки -->
            <AcrylicBrush x:Key="SoftGlassBrush" TintColor="#1C1C1E" TintOpacity="0.38" TintLuminosityOpacity="0.62" FallbackColor="#1C1C1E" />

            <FontFamily x:Key="IconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code,Cascadia Mono,Consolas</FontFamily>

            <!-- Парящий стеклянный остров -->
            <Style x:Key="IslandStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource IslandBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="SoftGlassStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SoftGlassBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <ThemeShadow />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Кнопка-иконка без рамки (Apple toolbar) -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.32" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HoverLayer" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="{TemplateBinding FontWeight}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Переключатель-иконка: во включённом состоянии мягкая акцентная подложка -->
            <Style x:Key="IconToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.32" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedLayer.Opacity" Value="1" />
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="Presenter.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedLayer.Opacity" Value="0.5" />
                                                <Setter Target="Presenter.Opacity" Value="0.32" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver" />
                                        <VisualState x:Name="IndeterminatePressed" />
                                        <VisualState x:Name="IndeterminateDisabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="CheckedLayer" Background="{StaticResource AccentSoftBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <Border x:Name="HoverLayer" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Сегмент Apple Segmented Control: выбранный сегмент — светлая «пилюля» внутри матового трека -->
            <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Background="Transparent" CornerRadius="6">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Focused" />
                                        <VisualState x:Name="Unfocused" />
                                        <VisualState x:Name="PointerFocused" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="CheckedLayer" Background="{StaticResource PillBrush}" CornerRadius="6" Opacity="0"
                                        BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0.5" />
                                <ContentPresenter x:Name="Presenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  FontWeight="Medium" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Матовый трек сегментированного переключателя -->
            <Style x:Key="SegmentTrackStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="2" />
            </Style>

            <!-- Текстовый чип (пресеты, история) -->
            <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource IslandBrush}" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- Круглая кнопка отправки -->
            <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,0,0,6" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <!-- Карточка Apple Wallet для сметы -->
            <Style x:Key="WalletCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <!-- Поле координат в стиле Figma/Shapr3D: буква-префикс слева, моноширинное значение -->
            <Style x:Key="CoordinateFieldStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="8,0,2,0" />
            </Style>

            <!-- Панель «Секущий бокс»: подпись грани, тонкий ползунок, моноширинное значение -->
            <Style x:Key="SectionSliderLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>

            <Style x:Key="SectionSliderValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionSliderLabelStyle}">
                <Setter Property="Grid.Column" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <Style x:Key="SectionSliderStyle" TargetType="Slider">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="StepFrequency" Value="0.05" />
                <Setter Property="SmallChange" Value="0.1" />
                <Setter Property="LargeChange" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsThumbToolTipEnabled" Value="False" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- Компактная кнопка стеклянной панели -->
            <Style x:Key="PanelButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>

            <!-- Чип действия на пилюле подложки -->
            <Style x:Key="PillChipStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="13" />
            </Style>

            <!-- Всплывающая стеклянная панель (Массив / Тиражировать): тот же акрил, что у островов -->
            <Style x:Key="GlassFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource IslandBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,10,12,12" />
                <Setter Property="UseLayoutRounding" Value="True" />
            </Style>

            <!-- Стеклянная панель «Состав Конструкторского Бюро» (шире стандартного Flyout) -->
            <Style x:Key="CouncilFlyoutPresenterStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource GlassFlyoutPresenterStyle}">
                <Setter Property="MaxWidth" Value="620" />
                <Setter Property="Padding" Value="14,12,14,14" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Карточка-кнопка варианта решения: на всю ширину, матовая подложка, мягкая подсветка при наведении -->
            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HoverLayer" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Stretch"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CoordinateNumberBoxStyle" TargetType="NumberBox">
                <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
                <Setter Property="SmallChange" Value="0.1" />
                <Setter Property="LargeChange" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="28" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
