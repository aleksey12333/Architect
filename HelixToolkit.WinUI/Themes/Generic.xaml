<!--
    Замена темы библиотеки HelixToolkit.WinUI 2.27.3 для unpackaged-сборки.
    Оригинальный Generic.xaml содержит служебные экземпляры Element3D/материалов (x:Key="sceneNodeGroupModel3D" и т.п.),
    создание которых XAML-парсером при загрузке темы роняет WinUI нативно (0xC000027B, 0x80004005).
    Здесь оставлены только стили и шаблон Viewport3DX; библиотечный HelixToolkit.WinUI.pri исключён в .csproj.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HelixToolkit.WinUI"
    xmlns:controls1="using:HelixToolkit.WinUI.Controls">

    <ControlTemplate x:Key="Element3DTemplate">
        <ContentPresenter x:Name="PART_Container" IsHitTestVisible="False" />
    </ControlTemplate>

    <Style TargetType="controls:Element3D">
        <Setter Property="Template" Value="{StaticResource Element3DTemplate}" />
    </Style>

    <Style TargetType="controls:ViewBoxModel3D">
        <Setter Property="Template" Value="{StaticResource Element3DTemplate}" />
    </Style>

    <Style TargetType="controls:CoordinateSystemModel3D">
        <Setter Property="Template" Value="{StaticResource Element3DTemplate}" />
    </Style>

    <Style TargetType="controls:Viewport3DX">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Viewport3DX">
                    <Grid HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{TemplateBinding Background}"
                          ManipulationMode="All">
                        <controls1:HelixItemsControl x:Name="PART_CoordinateGroup" />
                        <controls1:HelixItemsControl x:Name="PART_ItemsContainer" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="PART_HostPresenter" IsHitTestVisible="False"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
