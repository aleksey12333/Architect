<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AIArchitectStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AIArchitectStudio"
    xmlns:models="using:AIArchitectStudio.Models"
    xmlns:vm="using:AIArchitectStudio.ViewModels"
    xmlns:views="using:AIArchitectStudio.Views"
    xmlns:ai="using:AIArchitectStudio.Services.AI"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource ViewportBackgroundBrush}">
        <!-- Колонка 0 — 3D-холст с парящими островами; колонка 1 — боковой док Коллоквиума (Auto: 0 / 48 / 414 px) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <!-- «Массив / Тиражировать»: линейный массив N × шаг X/Z (мм) и копирование этажа вверх (пилюля выделения и инспектор) -->
            <Flyout x:Key="ArrayFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource GlassFlyoutPresenterStyle}">
                <StackPanel Width="252" Spacing="8">
                    <StackPanel.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                        <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71D;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('ArrayTitle', L.Language), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,2,0,0" Text="{x:Bind L.T('ArrayLinear', L.Language), Mode=OneWay}" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Text="{x:Bind L.T('ArrayCount', L.Language), Mode=OneWay}" />
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" Padding="2,0">
                            <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="2" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.ArrayCount, Mode=TwoWay}" />
                        </Border>
                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Text="{x:Bind L.T('ArrayStepX', L.Language), Mode=OneWay}" />
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" Padding="2,0">
                            <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="100" LargeChange="1000" Value="{x:Bind ViewModel.ArrayStepXMm, Mode=TwoWay}" />
                        </Border>
                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Text="{x:Bind L.T('ArrayStepZ', L.Language), Mode=OneWay}" />
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" Padding="2,0">
                            <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="100" LargeChange="1000" Value="{x:Bind ViewModel.ArrayStepZMm, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                    <Button Style="{StaticResource PanelButtonStyle}" Background="{StaticResource AccentSoftBrush}" Command="{x:Bind ViewModel.CreateArrayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71D;" FontSize="12" />
                            <TextBlock Text="{x:Bind L.T('ArrayCreate', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Margin="0,2" Background="{StaticResource StudioBorderBrush}" />
                    <Button Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.CopyFloorUpCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                            <TextBlock Text="{x:Bind L.T('ArrayFloorUp', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('ArrayFloorUpHint', L.Language), Mode=OneWay}" />
                </StackPanel>
            </Flyout>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="Delete" Invoked="OnDeleteAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnHelpAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- ═══════════════ 100% 3D-холст от края до края ═══════════════ -->
        <views:Viewport3DControl x:Name="Viewport" />

        <!-- Пустая сцена -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="360" IsHitTestVisible="False"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsSceneEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE80F;" FontSize="28" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{x:Bind L.T('EmptySceneTitle', L.Language), Mode=OneWay}" />
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{x:Bind L.T('EmptySceneHint', L.Language), Mode=OneWay}" />
        </StackPanel>

        <!-- ═══════════════ Левая палитра раздела: 1 — инструменты участка, 2 — объёмное моделирование и КР, 3 — планировки и ИОС ═══════════════ -->
        <Border x:Name="ToolPalette" Style="{StaticResource IslandStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,62,0,0"
                Padding="4" CornerRadius="14" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.VisNone(ViewModel.IsSolarEnabled, ViewModel.IsWebBridgeOpen, ViewModel.IsWalkthrough), Mode=OneWay}">
            <Grid>
            <!-- Раздел 1: Генплан и ГПЗУ (кнопки строятся в MainWindow.Wave7.cs) -->
            <StackPanel x:Name="SitePalette" Spacing="2" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsEnvSite), Mode=OneWay}" />
            <!-- Раздел 3: Планировки и ИОС (кнопки строятся в MainWindow.Wave7.cs) -->
            <StackPanel x:Name="LayoutPalette" Spacing="2" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsEnvInteriors), Mode=OneWay}" />
            <!-- Раздел 2: Архитектура и КР -->
            <StackPanel x:Name="AddElementButton" Spacing="2" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsEnvBuilding), Mode=OneWay}">
                <FontIcon Glyph="&#xE710;" FontSize="11" Margin="0,4,0,4" Foreground="{StaticResource TextSecondaryBrush}"
                          ToolTipService.ToolTip="{x:Bind L.T('AddElementTip', L.Language), Mode=OneWay}" />
                <Button Tag="Column" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddColumn', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                </Button>
                <Button Tag="Beam" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddBeam', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76F;" FontSize="14" />
                </Button>
                <Button Tag="Wall" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddWall', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                </Button>
                <Button Tag="Slab" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddSlab', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                </Button>
                <Button Tag="Foundation" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddFoundation', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE81E;" FontSize="14" />
                </Button>
                <Border Height="1" Margin="6,2" Background="{StaticResource StudioBorderBrush}" />
                <Button Tag="Window" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddWindow', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE737;" FontSize="14" />
                </Button>
                <Button Tag="Door" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddDoor', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8AD;" FontSize="14" />
                </Button>
                <Button Tag="Stairs" Click="OnAddElementClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="{x:Bind L.T('AddStairs', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE70E;" FontSize="14" />
                </Button>
                <Border Height="1" Margin="6,2" Background="{StaticResource StudioBorderBrush}" />
                <Button x:Name="LibraryButton" Click="OnLibraryClick" Style="{StaticResource IconButtonStyle}" Background="{StaticResource AccentSoftBrush}"
                        ToolTipService.ToolTip="{x:Bind L.T('LibOpenTip', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                </Button>
                <Button x:Name="DimensionsButton" Command="{x:Bind ViewModel.OpenBuildingDimensionsCommand}" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind L.T('W2DimsTip', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE740;" FontSize="14" />
                </Button>
                <Border Height="1" Margin="6,2" Background="{StaticResource StudioBorderBrush}" />
                <Button Command="{x:Bind ViewModel.OpenPhotoStudioCommand}" Style="{StaticResource IconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind L.T('W7ToolPhoto', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE722;" FontSize="14" />
                </Button>
                <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsStructuralMode, Mode=TwoWay}"
                              Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsStructuralModeAvailable), Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind L.T('W7ToolStructural', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                </ToggleButton>
                <Button Command="{x:Bind ViewModel.RunSchemeAuditCommand}" Style="{StaticResource IconButtonStyle}"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsStructuralModeAvailable), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.T('W7ToolAudit', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                </Button>
            </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Раздел 3: мульти-план пакетов этажей / подвал и вертикальная проверка (содержимое — MainWindow.Wave7.cs) ═══════════════ -->
        <Border x:Name="FloorPlanHost" Margin="66,62,368,118" CornerRadius="14" BorderThickness="1" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsMultiPlanVisible), Mode=OneWay}" />

        <!-- ═══════════════ Верхний парящий бар ═══════════════ -->
        <Border x:Name="TopBar" Grid.ColumnSpan="2" Style="{StaticResource IslandStyle}" Height="42" Margin="14,10,14,0" VerticalAlignment="Top" Padding="6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Слева: название и файл -->
                <StackPanel x:Name="TopLeftTools" Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="Architect Studio Pro" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,6,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <!-- «Начальный экран»: стартовое окно (новый проект, шаблоны, недавние .aia) без перезапуска -->
                    <Button x:Name="StartScreenButton" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.OpenStartScreenCommand}"
                            AutomationProperties.Name="{x:Bind L.T('W1StartScreen', L.Language), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('W1StartScreenTip', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    </Button>
                    <Border Width="1" Height="18" Margin="2,0,4,0" VerticalAlignment="Center" Background="{StaticResource StudioBorderBrush}" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind L.T('OpenMenu', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Tag="any" Click="OnOpenMenuClick" Text="{x:Bind L.T('OpenAny', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Tag="aia" Click="OnOpenMenuClick" Text="{x:Bind L.T('OpenProject', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="ifc" Click="OnOpenMenuClick" Text="{x:Bind L.T('OpenIfc', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="dxf" Click="OnOpenMenuClick" Text="{x:Bind L.T('OpenDxfUnderlay', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="dxf3d" Click="OnOpenMenuClick" Text="{x:Bind L.T('OpenDxf3D', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnOpenGpzuClick" Text="{x:Bind L.T('W5MenuOpen', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnSaveProjectClick"
                            ToolTipService.ToolTip="{x:Bind L.T('SaveAia', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind L.T('Export', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem Tag="ifc" Click="OnExportClick" Text="{x:Bind L.T('ExportIfc', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="dxf" Click="OnExportClick" Text="{x:Bind L.T('ExportDxf', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="obj" Click="OnExportClick" Text="{x:Bind L.T('ExportObj', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSubItem Text="{x:Bind L.T('Render4K', L.Language), Mode=OneWay}">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE722;" /></MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem Tag="sky" Click="OnRender4KClick" Text="{x:Bind L.T('Render4KSky', L.Language), Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE706;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Tag="alpha" Click="OnRender4KClick" Text="{x:Bind L.T('Render4KAlpha', L.Language), Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="{x:Bind L.T('ExportGost', L.Language), Mode=OneWay}">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem IsEnabled="False" FontSize="11" Text="{x:Bind L.T('GostA3', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A3|plan" Click="OnGostExportClick" Text="{x:Bind L.T('GostPlan', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A3|frame" Click="OnGostExportClick" Text="{x:Bind L.T('GostFrame', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A3|section" Click="OnGostExportClick" Text="{x:Bind L.T('GostSection', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem IsEnabled="False" FontSize="11" Text="{x:Bind L.T('GostA2', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A2|plan" Click="OnGostExportClick" Text="{x:Bind L.T('GostPlan', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A2|frame" Click="OnGostExportClick" Text="{x:Bind L.T('GostFrame', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutItem Tag="A2|section" Click="OnGostExportClick" Text="{x:Bind L.T('GostSection', L.Language), Mode=OneWay}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Click="OnGostAlbumClick" Text="{x:Bind L.T('GostAlbum', L.Language), Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind L.T('GostAlbumTip', L.Language), Mode=OneWay}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Модуль «Ведомость объёмов и сталей» -->
                    <Button x:Name="QuantitiesButton" Style="{StaticResource IconButtonStyle}" Click="OnQuantitiesClick"
                            Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsQuantityBuildingUi), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('QtyButtonTip', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- По центру: Segmented Control вида + инструменты отображения -->
                <StackPanel x:Name="TopCenterTools" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <!-- Волна 7: три раздела над одним проектом — 1. Генплан и ГПЗУ · 2. Архитектура и КР · 3. Планировки и ИОС -->
                    <Border x:Name="EnvironmentSegment" Style="{StaticResource SegmentTrackStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="DevEnvironment" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11"
                                         IsChecked="{x:Bind ViewModel.IsEnvSite, Mode=TwoWay}"
                                         Content="{x:Bind L.T('W6EnvSite', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvSiteHint', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="DevEnvironment" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11"
                                         IsChecked="{x:Bind ViewModel.IsEnvBuilding, Mode=TwoWay}"
                                         Content="{x:Bind L.T('W6EnvBuilding', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvBuildingHint', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="DevEnvironment" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11"
                                         IsChecked="{x:Bind ViewModel.IsEnvInteriors, Mode=TwoWay}"
                                         Content="{x:Bind L.T('W6EnvInteriors', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvInteriorsHint', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SegmentTrackStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" MinWidth="44"
                                         IsChecked="{x:Bind ViewModel.IsPerspectiveMode, Mode=TwoWay}"
                                         Content="{x:Bind L.T('View3D', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('View3DTitle', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" MinWidth="44"
                                         IsChecked="{x:Bind ViewModel.IsPlanMode, Mode=TwoWay}"
                                         Content="{x:Bind L.T('ViewPlan', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('ViewPlanTitle', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" MinWidth="44"
                                         IsChecked="{x:Bind ViewModel.IsSectionMode, Mode=TwoWay}"
                                         Content="{x:Bind L.T('ViewSection', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('ViewSectionTitle', L.Language), Mode=OneWay}" />
                            <!-- Режим «Конструкции (КЖ / КМ)» — только в разделе «2. Архитектура и КР» -->
                            <RadioButton x:Name="StructuralSegment" GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" MinWidth="44"
                                         Visibility="Collapsed"
                                         IsChecked="{x:Bind ViewModel.IsStructuralSegment, Mode=TwoWay}"
                                         Content="{x:Bind L.T('W2StructuralMode', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('W2StructuralModeTip', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <!-- Раздел 2: второстепенные переключатели отображения — в одном меню «Отображение» (оси, каркас, привязки, макет) -->
                    <Button x:Name="DisplayMenuButton" Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsEnvBuilding), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('W7Display', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <FontIcon Glyph="&#xE890;" FontSize="14" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.ShowGridAxes, Mode=TwoWay}" Text="{x:Bind L.T('Axes', L.Language), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsArchitectBuildingUi), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IsWireframe, Mode=TwoWay}" Text="{x:Bind L.T('Wireframe', L.Language), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsArchitectBuildingUi), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xF158;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IsOSnapEnabled, Mode=TwoWay}" Text="{x:Bind L.T('OSnapFull', L.Language), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsArchitectBuildingUi), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE707;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IsStressMapEnabled, Mode=TwoWay}" Text="{x:Bind L.T('StressMap', L.Language), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAnalysisBuildingUi), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IsRebarView, Mode=TwoWay}" Text="{x:Bind L.T('RebarTip', L.Language), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsRebarBuildingUi), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A9;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                                <ToggleMenuFlyoutItem IsChecked="{x:Bind ViewModel.IsClayMode, Mode=TwoWay}" Text="{x:Bind L.T('ClayFull', L.Language), Mode=OneWay}">
                                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></ToggleMenuFlyoutItem.Icon>
                                </ToggleMenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsSectionBoxEnabled, Mode=TwoWay}"
                                  Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsArchitectBuildingUi), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('SectionBox', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE7A8;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsUnderlayVisible, Mode=TwoWay}"
                                  Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasUnderlay), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('Underlay', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </ToggleButton>
                    <!-- Общие для всех разделов: рулетка, вписать; макет и инсоляция — по разделу -->
                    <ToggleButton x:Name="MeasureToggle" Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsMeasureMode, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('MeasureFull', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xED5E;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="SolarToggle" Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsSolarEnabled, Mode=TwoWay}"
                                  Visibility="{x:Bind local:XamlHelpers.VisAll(ViewModel.IsSolarUi, ViewModel.IsSiteOrBuilding), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('Solar', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE706;" FontSize="14" />
                    </ToggleButton>
                    <ToggleButton x:Name="WalkToggle" Style="{StaticResource IconToggleStyle}" IsChecked="{x:Bind ViewModel.IsWalkthrough, Mode=TwoWay}"
                                  Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsBuildingOrLayouts), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('WalkthroughFull', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE805;" FontSize="14" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ZoomToFitCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('CameraFit', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Справа: этаж, тема, язык, настройки -->
                <StackPanel x:Name="TopRightTools" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ComboBox Width="104" Height="30" FontSize="12" CornerRadius="8" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,2,0"
                              Background="{StaticResource TrackBrush}"
                              Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsBuildingOrLayouts), Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Levels}"
                              SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              ToolTipService.ToolTip="{x:Bind L.T('Level', L.Language), Mode=OneWay}" />
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind L.T('Theme', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE790;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="ThemeFlyout" Placement="BottomEdgeAlignedRight" Opening="OnThemeFlyoutOpening" />
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" FontWeight="SemiBold" MinWidth="34"
                            Content="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleLanguageCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('Language', L.Language), Mode=OneWay}" />
                    <Button x:Name="HelpButton" Style="{StaticResource IconButtonStyle}" Click="OnHelpClick"
                            ToolTipService.ToolTip="{x:Bind L.T('HelpTip', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnSettingsClick"
                            ToolTipService.ToolTip="{x:Bind L.T('Settings', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Парящая пилюля выбранного объекта ═══════════════ -->
        <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0"
                Padding="10,4,6,4" CornerRadius="12"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasSelection), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <FontIcon Glyph="{x:Bind ViewModel.SelectedGlyph, Mode=OneWay}" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Margin="8,0,10,0" MaxWidth="200">
                    <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedType, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Width="1" Height="18" Margin="2,0,4,0" Background="{StaticResource StudioBorderBrush}" />
                <TextBlock Text="{x:Bind L.T('Nudge', L.Language), Mode=OneWay}" FontSize="11" VerticalAlignment="Center" Margin="2,0,4,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="X−" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="x-" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="X+" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="x+" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="Y−" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="y-" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="Y+" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="y+" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="Z−" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="z-" />
                <Button Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource MonoFont}" Content="Z+" Command="{x:Bind ViewModel.NudgeCommand}" CommandParameter="z+" />
                <Border Width="1" Height="18" Margin="4,0" Background="{StaticResource StudioBorderBrush}" />
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RotateSelected90Command}"
                        ToolTipService.ToolTip="{x:Bind L.T('Rotate90', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE7AD;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.DuplicateSelectedCommand}"
                        ToolTipService.ToolTip="{x:Bind L.T('Duplicate', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.SelectSimilarOnFloorCommand}" Padding="8,0"
                        ToolTipService.ToolTip="{x:Bind L.T('SelectSimilarFull', L.Language), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B3;" FontSize="13" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Text="{x:Bind L.T('SelectSimilar', L.Language), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Flyout="{StaticResource ArrayFlyout}"
                        ToolTipService.ToolTip="{x:Bind L.T('ArrayTitle', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                </Button>
                <!-- Проёмы: добавить в стену / плиту, замуровать выбранный -->
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.AddWallOpeningCommand}"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsWallHostSelected), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.T('AddWallOpening', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE739;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.AddSlabOpeningCommand}"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsSlabHostSelected), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.T('AddSlabOpening', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.SealOpeningCommand}"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsOpeningSelected), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.T('SealOpening', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73B;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                        ToolTipService.ToolTip="{x:Bind L.T('DeleteFillingHint', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.DeselectCommand}"
                        ToolTipService.ToolTip="{x:Bind L.T('Deselect', L.Language), Mode=OneWay}">
                    <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Парящая панель «Секущий бокс» (Section Box) ═══════════════ -->
        <!-- ═══════════════ Панель режима «Конструкции (КЖ / КМ)» (содержимое строится в MainWindow.Wave2.cs) ═══════════════ -->
        <Border x:Name="StructuralPanel" Style="{StaticResource IslandStyle}" Width="340" Margin="0,62,14,14" Padding="12,10,8,10"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsStructuralMode), Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel x:Name="StructuralPanelContent" Spacing="8" />
            </ScrollViewer>
        </Border>

        <!-- ═══════════════ Правый док разделов 1 и 3 (на месте инспектора, 340 px): вкладки и содержимое — MainWindow.Wave7.cs ═══════════════ -->
        <Border x:Name="EnvironmentPanel" Width="340" Margin="0,62,14,14" Padding="8,8,4,10" CornerRadius="14" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Stretch" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsEnvironmentPanelVisible), Mode=OneWay}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="EnvironmentPanelTabs" Margin="0,0,4,0" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,0,8,0">
                    <StackPanel x:Name="EnvironmentPanelContent" Spacing="8" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Индикатор автосохранения -->
        <Border x:Name="AutoSavePill" Margin="0,0,368,16" Padding="10,4,12,4" CornerRadius="11" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasAutoSaveStatus), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{x:Bind ViewModel.AutoSaveStatusText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource IslandStyle}" Width="268" Margin="66,62,0,0" Padding="12,8,8,10"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsSectionPanelVisible), Mode=OneWay}">
            <StackPanel Spacing="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7A8;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{x:Bind L.T('SectionPanelTitle', L.Language), Mode=OneWay}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleSectionBoxCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('Deselect', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
                <TextBlock FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.ActiveSectionTitle, Mode=OneWay}" />

                <Grid ColumnSpacing="6" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                        <RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="X−" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="0" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinX, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxX, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMinX, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMinX), Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="X+" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinX, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxX, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMaxX, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMaxX), Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Text="Y−" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinY, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxY, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMinY, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMinY), Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Text="Y+" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="3" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinY, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxY, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMaxY, Mode=TwoWay}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMaxY), Mode=OneWay}" />
                    <TextBlock Grid.Row="4" Text="Z−" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="4" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinZ, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxZ, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMinZ, Mode=TwoWay}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMinZ), Mode=OneWay}" />
                    <TextBlock Grid.Row="5" Text="Z+" Style="{StaticResource SectionSliderLabelStyle}" />
                    <Slider Grid.Row="5" Grid.Column="1" Style="{StaticResource SectionSliderStyle}"
                            Minimum="{x:Bind ViewModel.SectionLimitMinZ, Mode=OneWay}" Maximum="{x:Bind ViewModel.SectionLimitMaxZ, Mode=OneWay}"
                            Value="{x:Bind ViewModel.SectionMaxZ, Mode=TwoWay}" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource SectionSliderValueStyle}" Text="{x:Bind local:XamlHelpers.Meters(ViewModel.SectionMaxZ), Mode=OneWay}" />
                </Grid>

                <Grid ColumnSpacing="6" RowSpacing="6" Margin="0,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.SectionLongitudinalCommand}"
                            Content="{x:Bind L.T('SectionLong', L.Language), Mode=OneWay}" />
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.SectionTransverseCommand}"
                            Content="{x:Bind L.T('SectionTrans', L.Language), Mode=OneWay}" />
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.SectionFloorCutCommand}"
                            Content="{x:Bind L.T('SectionFloor', L.Language), Mode=OneWay}" />
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.ResetSectionBoxCommand}"
                            Content="{x:Bind L.T('SectionReset', L.Language), Mode=OneWay}" />
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PanelButtonStyle}" Background="{StaticResource AccentSoftBrush}"
                            Command="{x:Bind ViewModel.SectionCameraCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('SectionCameraFull', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE722;" FontSize="12" />
                            <TextBlock Text="{x:Bind L.T('SectionCamera', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Правый парящий инспектор ═══════════════ -->
        <Border x:Name="InspectorIsland" Style="{StaticResource IslandStyle}" Width="340" Margin="0,62,14,14"
                HorizontalAlignment="Right"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsInspectorDockVisible), Mode=OneWay}"
                VerticalAlignment="{x:Bind local:XamlHelpers.CollapsedAlign(ViewModel.IsInspectorCollapsed), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="8,8,6,8" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentTrackStyle}">
                        <Grid>
                            <!-- «Оси» — с уровня «Архитектор», «Анализ» — модулями «КЭ-анализ» и «Инспектор коллизий» -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.StarIf(ViewModel.IsArchitectUi, 1.0), Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind local:XamlHelpers.StarIf(ViewModel.IsAnalysisTabUi, 1.1), Mode=OneWay}" />
                                <ColumnDefinition Width="1.05*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" GroupName="RightTab" HorizontalAlignment="Stretch" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11"
                                         IsChecked="{x:Bind ViewModel.IsInspectorTab, Mode=TwoWay}"
                                         Content="{x:Bind L.T('TabInspector', L.Language), Mode=OneWay}" />
                            <RadioButton Grid.Column="1" GroupName="RightTab" HorizontalAlignment="Stretch" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11"
                                         Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsArchitectUi), Mode=OneWay}"
                                         IsChecked="{x:Bind ViewModel.IsAxesTab, Mode=TwoWay}"
                                         Content="{x:Bind L.T('TabAxes', L.Language), Mode=OneWay}" />
                            <RadioButton Grid.Column="2" GroupName="RightTab" HorizontalAlignment="Stretch" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11"
                                         Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAnalysisTabUi), Mode=OneWay}"
                                         IsChecked="{x:Bind ViewModel.IsAnalysisTab, Mode=TwoWay}"
                                         Content="{x:Bind L.T('TabAnalysis', L.Language), Mode=OneWay}" />
                            <RadioButton Grid.Column="3" GroupName="RightTab" HorizontalAlignment="Stretch" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11"
                                         IsChecked="{x:Bind ViewModel.IsEstimateTab, Mode=TwoWay}"
                                         Content="{x:Bind L.T('TabEstimate', L.Language), Mode=OneWay}" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleInspectorCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('CollapsePanel', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind local:XamlHelpers.CollapseGlyph(ViewModel.IsInspectorCollapsed), Mode=OneWay}" FontSize="12"
                                  Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- ───────── Инспектор: дерево + координаты ───────── -->
                <Grid Grid.Row="1" Padding="8,0,8,10" RowSpacing="8"
                      Visibility="{x:Bind local:XamlHelpers.VisBoth(ViewModel.IsInspectorTab, ViewModel.IsInspectorCollapsed), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,4,0">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" Text="{x:Bind L.T('Objects', L.Language), Mode=OneWay}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{x:Bind ViewModel.SceneSummaryShort, Mode=OneWay}" />
                    </Grid>

                    <TreeView x:Name="BimTree" Grid.Row="1" SelectionMode="Single" Padding="0"
                              ItemsSource="{x:Bind ViewModel.TreeNodes}"
                              ItemInvoked="OnTreeItemInvoked">
                        <TreeView.Resources>
                            <x:Double x:Key="TreeViewItemMinHeight">26</x:Double>
                            <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BimTreeNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}" MinHeight="26" Height="26" Padding="0" CornerRadius="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Subtitle}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Координаты и габариты (Figma / Shapr3D), пирог конструкции, усилия КЭ-расчёта -->
                    <ScrollViewer Grid.Row="2" MaxHeight="620" Padding="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6" Padding="4,0,10,0">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                            <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                        </StackPanel.Resources>

                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,2" Text="{x:Bind L.T('CoordsAndSize', L.Language), Mode=OneWay}" />

                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.HasSelection), Mode=OneWay}"
                                   Text="{x:Bind L.T('NoSelection', L.Language), Mode=OneWay}" />

                        <StackPanel Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasSelection), Mode=OneWay}">
                            <!-- Мультивыделение (Shift + клик, «Однотипные на этаже»): пакетная правка одним шагом Undo -->
                            <Border Style="{StaticResource WalletCardStyle}" Background="{StaticResource AccentSoftBrush}" Padding="10,7"
                                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsMultiSelection), Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B3;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.SelectionHeaderText, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               Text="{x:Bind ViewModel.SelectionTypesText, Mode=OneWay}" />
                                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('BatchHint', L.Language), Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CoordinateFieldStyle}" Padding="2,0" Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsMultiSelection), Mode=OneWay}">
                                <TextBox FontSize="12" Text="{x:Bind ViewModel.InspectorName, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Border>

                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="X" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Value="{x:Bind ViewModel.PosX, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Y" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Value="{x:Bind ViewModel.PosY, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Z" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Value="{x:Bind ViewModel.PosZ, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="W" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0.01" Value="{x:Bind ViewModel.SizeW, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="H" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0.01" Value="{x:Bind ViewModel.SizeH, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CoordinateFieldStyle}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="D" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0.01" Value="{x:Bind ViewModel.SizeD, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CoordinateFieldStyle}"
                                        ToolTipService.ToolTip="{x:Bind L.T('RotationY', L.Language), Mode=OneWay}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="R°" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="15" LargeChange="90" Value="{x:Bind ViewModel.RotY, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CoordinateFieldStyle}"
                                        ToolTipService.ToolTip="{x:Bind L.T('LevelIndex', L.Language), Mode=OneWay}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock Text="L" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="1" Minimum="0" Value="{x:Bind ViewModel.LevelValue, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Материал (пакетно — всем выделенным) и «Массив / Тиражировать» -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0"
                                          Background="{StaticResource TrackBrush}"
                                          ItemsSource="{x:Bind ViewModel.MaterialNames}"
                                          SelectedItem="{x:Bind ViewModel.InspectorMaterial, Mode=TwoWay}"
                                          ToolTipService.ToolTip="{x:Bind L.T('Material', L.Language), Mode=OneWay}" />
                                <Button Grid.Column="1" Style="{StaticResource PanelButtonStyle}" Flyout="{StaticResource ArrayFlyout}"
                                        ToolTipService.ToolTip="{x:Bind L.T('ArrayFloorUpHint', L.Language), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71D;" FontSize="12" />
                                        <TextBlock FontSize="12" Text="{x:Bind L.T('ArrayTitle', L.Language), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Сечение колонны / балки: смена профиля в 1 клик -->
                            <StackPanel Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsProfiledSelected), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,2,0,0" Text="{x:Bind L.T('ProfileSection', L.Language), Mode=OneWay}" />
                                <Border Style="{StaticResource SegmentTrackStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="Profile" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsProfileRect, Mode=TwoWay}" Content="{x:Bind L.T('ProfileRect', L.Language), Mode=OneWay}"
                                                     ToolTipService.ToolTip="{x:Bind L.T('ProfileRectFull', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="1" GroupName="Profile" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsProfileCircle, Mode=TwoWay}" Content="{x:Bind L.T('ProfileCircle', L.Language), Mode=OneWay}"
                                                     ToolTipService.ToolTip="{x:Bind L.T('ProfileCircleFull', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="2" GroupName="Profile" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsProfilePipe, Mode=TwoWay}" Content="{x:Bind L.T('ProfilePipe', L.Language), Mode=OneWay}"
                                                     ToolTipService.ToolTip="{x:Bind L.T('ProfilePipeFull', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="3" GroupName="Profile" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsProfileIBeam, Mode=TwoWay}" Content="{x:Bind L.T('ProfileIBeam', L.Language), Mode=OneWay}"
                                                     ToolTipService.ToolTip="{x:Bind L.T('ProfileIBeamFull', L.Language), Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsProfileThicknessVisible), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CoordinateFieldStyle}" ToolTipService.ToolTip="{x:Bind L.T('ProfileWall', L.Language), Mode=OneWay}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="t" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="0.001" Minimum="0" Value="{x:Bind ViewModel.ProfileWallValue, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" ToolTipService.ToolTip="{x:Bind L.T('ProfileWeb', L.Language), Mode=OneWay}"
                                            Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsWebThicknessVisible), Mode=OneWay}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="tw" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" SmallChange="0.001" Minimum="0" Value="{x:Bind ViewModel.ProfileWebValue, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Форма кровли: только явный выбор, без подмены -->
                            <StackPanel Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsRoofSelected), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,2,0,0" Text="{x:Bind L.T('RoofSection', L.Language), Mode=OneWay}" />
                                <Border Style="{StaticResource SegmentTrackStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" GroupName="RoofShape" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsRoofFlat, Mode=TwoWay}" Content="{x:Bind L.T('RoofFlat', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="1" GroupName="RoofShape" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsRoofGable, Mode=TwoWay}" Content="{x:Bind L.T('RoofGable', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="2" GroupName="RoofShape" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsRoofHip, Mode=TwoWay}" Content="{x:Bind L.T('RoofHip', L.Language), Mode=OneWay}" />
                                        <RadioButton Grid.Column="3" GroupName="RoofShape" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                                     IsChecked="{x:Bind ViewModel.IsRoofShed, Mode=TwoWay}" Content="{x:Bind L.T('RoofShed', L.Language), Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Состав слоёв (Пирог): стена, плита, кровля, фундамент -->
                            <StackPanel Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsLayerHostSelected), Mode=OneWay}">
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="{x:Bind L.T('LayersTitle', L.Language), Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                        <Button Style="{StaticResource IconButtonStyle}" Padding="8,0" Command="{x:Bind ViewModel.AddLayerCommand}">
                                            <TextBlock FontSize="11" Text="{x:Bind L.T('LayerAdd', L.Language), Mode=OneWay}" />
                                        </Button>
                                        <Button x:Name="LayerPresetsButton" Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind L.T('LayerPresets', L.Language), Mode=OneWay}">
                                            <FontIcon Glyph="&#xE81E;" FontSize="13" />
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem Command="{x:Bind ViewModel.ApplyLayerPresetCommand}" CommandParameter="floor" Text="{x:Bind L.T('PresetFloorLayers', L.Language), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Command="{x:Bind ViewModel.ApplyLayerPresetCommand}" CommandParameter="flat_roof" Text="{x:Bind L.T('PresetRoofLayers', L.Language), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Command="{x:Bind ViewModel.ApplyLayerPresetCommand}" CommandParameter="foundation" Text="{x:Bind L.T('PresetFoundationLayers', L.Language), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Command="{x:Bind ViewModel.ApplyLayerPresetCommand}" CommandParameter="exterior_wall" Text="{x:Bind L.T('PresetWallLayers', L.Language), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9CA;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Command="{x:Bind ViewModel.ClearLayersCommand}" Text="{x:Bind L.T('LayersClear', L.Language), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasNoLayers), Mode=OneWay}"
                                           Text="{x:Bind L.T('LayersEmpty', L.Language), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedLayers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:MaterialLayer">
                                            <Grid ColumnSpacing="4" Margin="0,0,0,4">
                                                <Grid.Resources>
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                    <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                                                    <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="4" Height="22" CornerRadius="2" VerticalAlignment="Center" Background="{x:Bind local:XamlHelpers.HexBrush(ColorHex), Mode=OneWay}" />
                                                <Border Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" Padding="0">
                                                    <TextBox FontSize="11" Text="{x:Bind Name, Mode=TwoWay}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                                </Border>
                                                <Border Grid.Column="2" Style="{StaticResource CoordinateFieldStyle}" Padding="4,0,0,0"
                                                        ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('ThicknessMm')}">
                                                    <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" FontSize="11" Minimum="1" SmallChange="10" LargeChange="50"
                                                               Value="{x:Bind ThicknessMm, Mode=TwoWay}" />
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="26" MinWidth="26" Tag="{x:Bind}" Click="OnLayerRoleClick"
                                                        ToolTipService.ToolTip="{x:Bind RoleTitle, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind RoleGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Width="24" MinWidth="24" Tag="{x:Bind}" Click="OnRemoveLayerClick"
                                                        ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('LayerRemove')}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasLayers), Mode=OneWay}"
                                           Text="{x:Bind ViewModel.LayersTotalText, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Свойства пользователя: общие параметры элемента (марка, огнестойкость, поставщик…), пакетно — всем выделенным -->
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,0" Text="{x:Bind L.T('UserParamsTitle', L.Language), Mode=OneWay}" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasNoUserParameters), Mode=OneWay}"
                                           Text="{x:Bind L.T('UserParamsEmpty', L.Language), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.UserParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UserParameterItem">
                                            <Grid ColumnSpacing="4" Margin="0,0,0,4">
                                                <Grid.Resources>
                                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                    <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                                                    <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                                                </Grid.Resources>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
                                                <Border Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}" Padding="0" Visibility="{x:Bind local:XamlHelpers.Vis(IsText)}">
                                                    <TextBox FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Text="{x:Bind ValueText, Mode=TwoWay}" />
                                                </Border>
                                                <CheckBox Grid.Column="1" MinWidth="0" MinHeight="26" Padding="4,0,0,0" VerticalAlignment="Center"
                                                          Visibility="{x:Bind local:XamlHelpers.Vis(IsBool)}" IsChecked="{x:Bind BoolValue, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Unit}" />
                                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="24" MinWidth="24" Tag="{x:Bind}" Click="OnRemoveUserParameterClick"
                                                        ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('UserParamRemove')}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="108" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CoordinateFieldStyle}" Padding="0">
                                        <TextBox FontSize="11" VerticalAlignment="Center" KeyDown="OnUserParameterNameKeyDown"
                                                 PlaceholderText="{x:Bind L.T('UserParamName', L.Language), Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.NewUserParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Height="28" FontSize="11" CornerRadius="6" BorderThickness="0"
                                              Background="{StaticResource TrackBrush}"
                                              ItemsSource="{x:Bind ViewModel.UserParameterSpecs}"
                                              SelectedItem="{x:Bind ViewModel.NewUserParameterSpec, Mode=TwoWay}"
                                              ToolTipService.ToolTip="{x:Bind L.T('UserParamKind', L.Language), Mode=OneWay}" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Padding="8,0" Command="{x:Bind ViewModel.AddUserParameterCommand}"
                                            ToolTipService.ToolTip="{x:Bind L.T('UserParamAddHint', L.Language), Mode=OneWay}">
                                        <TextBlock FontSize="11" Text="{x:Bind L.T('UserParamAdd', L.Language), Mode=OneWay}" />
                                    </Button>
                                </Grid>
                                <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{x:Bind local:XamlHelpers.VisText(ViewModel.UserParametersBatchText), Mode=OneWay}"
                                           Text="{x:Bind ViewModel.UserParametersBatchText, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Паспорт свойств Renga: идентификация, расчётные величины и инженерные характеристики (строится в MainWindow.Wave2.cs) -->
                            <StackPanel x:Name="RengaPropertiesHost" Spacing="4" Margin="0,4,0,0" />

                            <!-- Усилия КЭ-расчёта: N, M, Q, прогиб, продавливание, K_исп (модуль «КЭ-анализ и карта напряжений») -->
                            <Border Style="{StaticResource WalletCardStyle}" Padding="10,8" Margin="0,4,0,0"
                                    Visibility="{x:Bind local:XamlHelpers.VisAll(ViewModel.HasForces, ViewModel.IsAnalysisModule), Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('ForcesTitle', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{x:Bind local:XamlHelpers.ColorBrush(ViewModel.ForceKColor), Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipK, Mode=OneWay}"
                                                   Text="{x:Bind ViewModel.ForceKText, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Height="4" CornerRadius="2" Background="{StaticResource TrackBrush}">
                                        <Border HorizontalAlignment="Left" CornerRadius="2" Width="{x:Bind local:XamlHelpers.BarWidth(ViewModel.ForceKFraction, 248), Mode=OneWay}"
                                                Background="{x:Bind local:XamlHelpers.ColorBrush(ViewModel.ForceKColor), Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" RowSpacing="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipN, Mode=OneWay}" Text="{x:Bind L.T('ForceN', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ForceNText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipM, Mode=OneWay}" Text="{x:Bind L.T('ForceM', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ForceMText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipQ, Mode=OneWay}" Text="{x:Bind L.T('ForceQ', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ForceQText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipF, Mode=OneWay}" Text="{x:Bind L.T('ForceF', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ForceFText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipLambda, Mode=OneWay}" Text="{x:Bind L.T('ForceLambda', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ForceLambdaText, Mode=OneWay}" />
                                        <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.ForceTipPunch, Mode=OneWay}" Text="{x:Bind L.T('ForcePunch', L.Language), Mode=OneWay}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{x:Bind local:XamlHelpers.ColorBrush(ViewModel.ForcePunchColor), Mode=OneWay}" Text="{x:Bind ViewModel.ForcePunchText, Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.ForceGoverningText, Mode=OneWay}" />
                                    <!-- Напряжения σ_max / τ, МПа, против расчётного сопротивления сечения (логический аудит КЭ-расчёта) -->
                                    <TextBlock FontSize="11" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}"
                                               Visibility="{x:Bind local:XamlHelpers.VisText(ViewModel.ForceStressText), Mode=OneWay}"
                                               Text="{x:Bind ViewModel.ForceStressText, Mode=OneWay}" />
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" MaxLines="4"
                                               Visibility="{x:Bind local:XamlHelpers.VisText(ViewModel.ForceNotesText), Mode=OneWay}"
                                               Text="{x:Bind ViewModel.ForceNotesText, Mode=OneWay}" />
                                    <!-- Паспорт расчёта: формулы, пункты СП, источник характеристик материала и сбор нагрузок -->
                                    <Button HorizontalAlignment="Stretch" Height="28" CornerRadius="7" Padding="8,0" Margin="0,2,0,0"
                                            Background="{StaticResource AccentSoftBrush}" BorderThickness="0"
                                            Command="{x:Bind ViewModel.OpenPassportCommand}"
                                            ToolTipService.ToolTip="{x:Bind L.T('PassportButtonTip', L.Language), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{x:Bind L.T('PassportButton', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{x:Bind local:XamlHelpers.VisAll(ViewModel.IsNonStructuralSelected, ViewModel.IsAnalysisModule), Mode=OneWay}"
                                       Text="{x:Bind L.T('ForcesNone', L.Language), Mode=OneWay}" />

                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind ViewModel.SelectedDetails, Mode=OneWay}" />
                        </StackPanel>

                        <!-- ───────── Ручное редактирование: дублирование, разделение, примыкание к уровню, тип ГОСТ/СП ───────── -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" Text="{x:Bind L.T('ManualTitle', L.Language), Mode=OneWay}"
                                   Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsManualEditVisible), Mode=OneWay}" />
                        <Border x:Name="ManualEditCard" Style="{StaticResource WalletCardStyle}" Padding="10,9"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsManualEditVisible), Mode=OneWay}">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <TextBlock FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedStandardText, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.SelectedStandardText, Mode=OneWay}" />
                                </StackPanel>
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Button Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            <TextBlock FontSize="12" Text="{x:Bind L.T('ManualDuplicate', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Command="{x:Bind ViewModel.DuplicateWithOffsetCommand}" CommandParameter="axis" Text="{x:Bind L.T('ManualDuplicateAxis', L.Language), Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE76C;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Command="{x:Bind ViewModel.DuplicateWithOffsetCommand}" CommandParameter="z" Text="{x:Bind L.T('ManualDuplicateZ', L.Language), Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74B;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Command="{x:Bind ViewModel.DuplicateWithOffsetCommand}" CommandParameter="up" Text="{x:Bind L.T('ManualDuplicateUp', L.Language), Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74A;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SplitSelectedCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanSplitSelected, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind L.T('ManualSplitTip', L.Language), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C6;" FontSize="11" />
                                            <TextBlock FontSize="12" Text="{x:Bind L.T('ManualSplitShort', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.SnapSelectedToLevelCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanSnapSelected, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind L.T('ManualSnapTip', L.Language), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                            <TextBlock FontSize="12" Text="{x:Bind L.T('ManualSnapShort', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Background="{StaticResource AccentSoftBrush}"
                                            Command="{x:Bind ViewModel.OpenLibraryCommand}" ToolTipService.ToolTip="{x:Bind L.T('ManualAssignType', L.Language), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F1;" FontSize="11" />
                                            <TextBlock FontSize="12" Text="{x:Bind L.T('LibBuiltIn', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('ManualHint', L.Language), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- ───────── Параметрические инструменты: П-образная лестница и скатная кровля по углу ───────── -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" Text="{x:Bind L.T('ToolsTitle', L.Language), Mode=OneWay}"
                                   Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAnyToolVisible), Mode=OneWay}" />
                        <Border Style="{StaticResource WalletCardStyle}" Padding="10,9"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsStairToolVisible), Mode=OneWay}">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                        <FontIcon Glyph="{x:Bind ViewModel.StairToolGlyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{x:Bind L.T('W1StairTitle', L.Language), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1StairHint', L.Language), Mode=OneWay}" />
                                <Grid ColumnSpacing="6" RowSpacing="5">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1StairShape', L.Language), Mode=OneWay}" />
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0" Background="{StaticResource TrackBrush}"
                                              ItemsSource="{x:Bind ViewModel.StairShapeTitles, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.StairShapeIndex, Mode=TwoWay}" />
                                    <TextBlock Grid.Row="1" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1StairConstruction', L.Language), Mode=OneWay}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0" Background="{StaticResource TrackBrush}"
                                              ItemsSource="{x:Bind ViewModel.StairConstructionTitles, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.StairConstructionIndex, Mode=TwoWay}" />
                                </Grid>
                                <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource HoverBrush}"
                                        ToolTipService.ToolTip="{x:Bind L.T('StairToolWidth', L.Language), Mode=OneWay}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('StairToolWidth', L.Language), Mode=OneWay}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="900" Maximum="3000" SmallChange="50" LargeChange="100"
                                                   Value="{x:Bind ViewModel.StairFlightWidthMm, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{x:Bind ViewModel.StairToolPreviewText, Mode=OneWay}" />
                                <Button Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.GenerateStairCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.StairToolButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WalletCardStyle}" Padding="10,9"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsRoofToolVisible), Mode=OneWay}">
                            <StackPanel Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource AccentSoftBrush}">
                                        <FontIcon Glyph="{x:Bind ViewModel.RoofToolGlyph}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{x:Bind L.T('W1RoofTitle', L.Language), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1RoofHint', L.Language), Mode=OneWay}" />
                                <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource HoverBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('RoofToolAngle', L.Language), Mode=OneWay}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="5" Maximum="60" SmallChange="1" LargeChange="5"
                                                   Value="{x:Bind ViewModel.RoofPitchDeg, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{x:Bind ViewModel.RoofToolPreviewText, Mode=OneWay}" />
                                <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource HoverBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1RoofThickness', L.Language), Mode=OneWay}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="80" Maximum="600" SmallChange="10" LargeChange="50"
                                                   Value="{x:Bind ViewModel.RoofSlabThicknessMm, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource HoverBrush}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('W1RoofOverhang', L.Language), Mode=OneWay}" />
                                        <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0" Maximum="1500" SmallChange="50" LargeChange="100"
                                                   Value="{x:Bind ViewModel.RoofOverhangMm, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <Button Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="gable_hollow"
                                            Content="{x:Bind L.T('W1Roof_gable_hollow', L.Language), Mode=OneWay}" />
                                    <Button Grid.Column="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="hip_hollow"
                                            Content="{x:Bind L.T('W1Roof_hip_hollow', L.Language), Mode=OneWay}" />
                                    <Button Grid.Column="2" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="shed_hollow"
                                            Content="{x:Bind L.T('W1Roof_shed_hollow', L.Language), Mode=OneWay}" />
                                    <Button Grid.Row="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="flat_parapet"
                                            Content="{x:Bind L.T('W1Roof_flat_parapet', L.Language), Mode=OneWay}" />
                                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="mansard"
                                            Content="{x:Bind L.T('W1Roof_mansard', L.Language), Mode=OneWay}" />
                                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PanelButtonStyle}" HorizontalAlignment="Stretch" Padding="4,0" FontSize="11" Command="{x:Bind ViewModel.MakeHollowRoofCommand}" CommandParameter="barrel_vault"
                                            Content="{x:Bind L.T('W1Roof_barrel_vault', L.Language), Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ───────── Оси: явные (с чертежа / вручную) или автоматические ───────── -->
                <Grid Grid.Row="1" Padding="8,0,8,10" RowSpacing="8"
                      Visibility="{x:Bind local:XamlHelpers.VisBoth(ViewModel.IsAxesTab, ViewModel.IsInspectorCollapsed), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="4" Margin="4,2,4,0">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" Text="{x:Bind L.T('AxesBuilding', L.Language), Mode=OneWay}" />
                        <ComboBox HorizontalAlignment="Stretch" Height="30" FontSize="12" CornerRadius="8" BorderThickness="0" Background="{StaticResource TrackBrush}"
                                  ItemsSource="{x:Bind ViewModel.AxesGroups}" SelectedItem="{x:Bind ViewModel.SelectedAxesGroup, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="4,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{x:Bind ViewModel.AxesStatusText, Mode=OneWay}" />
                    <ListView x:Name="AxesList" Grid.Row="2" SelectionMode="None" ItemsSource="{x:Bind ViewModel.EditableAxes}"
                              IsEnabled="{x:Bind ViewModel.AreAxesExplicit, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StructuralGridAxis">
                                <Grid ColumnSpacing="6">
                                    <Grid.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                                        <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CoordinateFieldStyle}" Padding="2,0">
                                        <TextBox FontSize="12" FontWeight="SemiBold" Text="{x:Bind Label, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DirectionTitle}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <NumberBox Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Value="{x:Bind Coordinate, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}" Click="OnRemoveAxisClick"
                                            ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('AxesRemove')}">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="3" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12" Command="{x:Bind ViewModel.AddAxisCommand}" CommandParameter="x"
                                Content="{x:Bind L.T('AxesAddNumeric', L.Language), Mode=OneWay}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12" Command="{x:Bind ViewModel.AddAxisCommand}" CommandParameter="z"
                                Content="{x:Bind L.T('AxesAddLetter', L.Language), Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12" Command="{x:Bind ViewModel.EditAutoAxesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreAxesAuto, Mode=OneWay}"
                                Content="{x:Bind L.T('AxesEdit', L.Language), Mode=OneWay}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12" Command="{x:Bind ViewModel.ResetAxesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreAxesExplicit, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind L.T('AxesResetFull', L.Language), Mode=OneWay}"
                                Content="{x:Bind L.T('AxesReset', L.Language), Mode=OneWay}" />
                    </Grid>
                    <Button Grid.Row="5" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" FontSize="12"
                            Background="{StaticResource AccentSoftBrush}" BorderThickness="0"
                            Command="{x:Bind ViewModel.OpenBuildingDimensionsCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('W2DimsTip', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE740;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{x:Bind L.T('W2Dims', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ───────── Анализ: нагрузки площадки, результаты КЭ-расчёта, Clash Detection ───────── -->
                <ScrollViewer Grid.Row="1" Padding="8,0,8,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind local:XamlHelpers.VisBoth(ViewModel.IsAnalysisTab, ViewModel.IsInspectorCollapsed), Mode=OneWay}">
                    <StackPanel Spacing="8" Padding="0,0,6,0">
                        <StackPanel.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            <Thickness x:Key="TextControlThemePadding">6,4,4,4</Thickness>
                            <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
                        </StackPanel.Resources>

                        <StackPanel Spacing="8" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAnalysisModule), Mode=OneWay}">
                        <StackPanel Margin="4,2,4,0" Spacing="1">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" Text="{x:Bind L.T('LoadsTitle', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('AnalysisNorms', L.Language), Mode=OneWay}" />
                        </StackPanel>

                        <!-- Паспорт расчёта выбранного несущего элемента -->
                        <Button HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="10,0"
                                Background="{StaticResource AccentSoftBrush}" BorderThickness="0"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasForces), Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenPassportCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('PassportButtonTip', L.Language), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{x:Bind ViewModel.PassportButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <!-- Логический аудит расчётной схемы: баланс сил, 5 критериев, напряжения σ / τ -->
                        <Button HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="10,0"
                                Background="{StaticResource HoverBrush}" BorderThickness="0"
                                Command="{x:Bind ViewModel.RunSchemeAuditCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('W2AuditTip', L.Language), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F5;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('W2Audit', L.Language), Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Grid ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Margin="4,0" Text="{x:Bind L.T('SnowRegion', L.Language), Mode=OneWay}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Margin="4,0" Text="{x:Bind L.T('SnowLoad', L.Language), Mode=OneWay}" />
                            <ComboBox Grid.Row="1" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0" Background="{StaticResource TrackBrush}"
                                      ItemsSource="{x:Bind ViewModel.SnowRegionTitles}" SelectedIndex="{x:Bind ViewModel.SnowRegionIndex, Mode=TwoWay}" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="80" Maximum="600" SmallChange="10" LargeChange="40"
                                           Value="{x:Bind ViewModel.SnowLoadKg, Mode=TwoWay}" />
                            </Border>
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Margin="4,0" Text="{x:Bind L.T('WindRegion', L.Language), Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Margin="4,0" Text="{x:Bind L.T('WindLoad', L.Language), Mode=OneWay}" />
                            <ComboBox Grid.Row="3" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0" Background="{StaticResource TrackBrush}"
                                      ItemsSource="{x:Bind ViewModel.WindRegionTitles}" SelectedIndex="{x:Bind ViewModel.WindRegionIndex, Mode=TwoWay}" />
                            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="17" Maximum="85" SmallChange="1" LargeChange="5"
                                           Value="{x:Bind ViewModel.WindLoadKg, Mode=TwoWay}" />
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="4,2,4,0" Text="{x:Bind L.T('Seismicity', L.Language), Mode=OneWay}" />
                        <Border Style="{StaticResource SegmentTrackStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" GroupName="Seismic" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="6" IsChecked="{x:Bind ViewModel.IsSeismic6, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1" GroupName="Seismic" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="7" IsChecked="{x:Bind ViewModel.IsSeismic7, Mode=TwoWay}" />
                                <RadioButton Grid.Column="2" GroupName="Seismic" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="8" IsChecked="{x:Bind ViewModel.IsSeismic8, Mode=TwoWay}" />
                                <RadioButton Grid.Column="3" GroupName="Seismic" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="9" IsChecked="{x:Bind ViewModel.IsSeismic9, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="4,2,4,0" Text="{x:Bind L.T('ConcreteClassLabel', L.Language), Mode=OneWay}" />
                        <Border Style="{StaticResource SegmentTrackStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" GroupName="Concrete" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="B20" IsChecked="{x:Bind ViewModel.IsConcreteB20, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1" GroupName="Concrete" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="B25" IsChecked="{x:Bind ViewModel.IsConcreteB25, Mode=TwoWay}" />
                                <RadioButton Grid.Column="2" GroupName="Concrete" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="B30" IsChecked="{x:Bind ViewModel.IsConcreteB30, Mode=TwoWay}" />
                                <RadioButton Grid.Column="3" GroupName="Concrete" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="B40" IsChecked="{x:Bind ViewModel.IsConcreteB40, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="4,2,4,0" Text="{x:Bind L.T('RebarClassLabel', L.Language), Mode=OneWay}" />
                        <Border Style="{StaticResource SegmentTrackStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" GroupName="Rebar" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="А240" IsChecked="{x:Bind ViewModel.IsRebarA240, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1" GroupName="Rebar" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="А400" IsChecked="{x:Bind ViewModel.IsRebarA400, Mode=TwoWay}" />
                                <RadioButton Grid.Column="2" GroupName="Rebar" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch" Content="А500С" IsChecked="{x:Bind ViewModel.IsRebarA500C, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="6" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="4,2,4,0" Text="{x:Bind L.T('LiveLoad', L.Language), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FieldLabelStyle}" Margin="4,2,4,0" Text="{x:Bind L.T('SoilBearing', L.Language), Mode=OneWay}" />
                            <Border Grid.Row="1" Style="{StaticResource CoordinateFieldStyle}">
                                <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0" Maximum="50" SmallChange="0.5" LargeChange="1" Value="{x:Bind ViewModel.LiveLoadValue, Mode=TwoWay}" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CoordinateFieldStyle}">
                                <NumberBox Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="50" Maximum="2000" SmallChange="25" LargeChange="100" Value="{x:Bind ViewModel.SoilBearingValue, Mode=TwoWay}" />
                            </Border>
                        </Grid>

                        <!-- Результаты экспресс-расчёта -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="4,8,4,0" Text="{x:Bind L.T('AnalysisResults', L.Language), Mode=OneWay}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressMaxK', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{x:Bind local:XamlHelpers.ColorBrush(ViewModel.StressMaxKColor), Mode=OneWay}" Text="{x:Bind ViewModel.StressMaxKText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressOverloaded', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressOverloadedText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource WalletCardStyle}">
                                <Grid ColumnSpacing="8" RowSpacing="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressMaxF', L.Language), Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressMaxDeflectionText, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressPunching', L.Language), Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressPunchingText, Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressTime', L.Language), Mode=OneWay}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressTimeText, Mode=OneWay}" />
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="{x:Bind ViewModel.StressBaseShearText, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ToggleButton HorizontalAlignment="Stretch" Height="30" CornerRadius="8" FontSize="12" IsChecked="{x:Bind ViewModel.IsStressMapEnabled, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                <TextBlock Text="{x:Bind L.T('StressMap', L.Language), Mode=OneWay}" />
                            </StackPanel>
                        </ToggleButton>
                        </StackPanel>

                        <!-- Инспектор коллизий каркаса (модуль) -->
                        <StackPanel Spacing="8" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsClashModule), Mode=OneWay}">
                        <Grid Margin="4,10,0,0">
                            <StackPanel Spacing="1">
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" Text="{x:Bind L.T('ClashTitle', L.Language), Mode=OneWay}" />
                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.ClashSummaryText, Mode=OneWay}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RunClashDetectionCommand}"
                                    ToolTipService.ToolTip="{x:Bind L.T('ClashRefresh', L.Language), Mode=OneWay}">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Clashes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ClashItem">
                                    <Border Style="{StaticResource WalletCardStyle}" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel Spacing="5">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind SeverityGlyph}" FontSize="12" Foreground="{x:Bind local:XamlHelpers.SeverityBrush(IsCritical)}" />
                                                <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind CategoryTitle}" />
                                                <TextBlock Grid.Column="2" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Id}" />
                                            </Grid>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" MaxLines="4" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Description}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Style="{StaticResource PillChipStyle}" Tag="{x:Bind}" Click="OnClashFocusClick">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE71E;" FontSize="11" />
                                                        <TextBlock FontSize="11" Text="{x:Bind local:XamlHelpers.Text('ClashFocus')}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PillChipStyle}" Tag="{x:Bind}" Click="OnClashFixClick" Background="{StaticResource AccentSoftBrush}"
                                                        Visibility="{x:Bind local:XamlHelpers.Vis(HasFix)}" ToolTipService.ToolTip="{x:Bind FixLabel}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE90F;" FontSize="11" />
                                                        <TextBlock FontSize="11" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="{x:Bind FixLabel}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ───────── Смета: карточки Apple Wallet ───────── -->
                <ScrollViewer Grid.Row="1" Padding="8,0,8,10" VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind local:XamlHelpers.VisBoth(ViewModel.IsEstimateTab, ViewModel.IsInspectorCollapsed), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <Button HorizontalAlignment="Stretch" Height="32" CornerRadius="8" FontSize="12" Click="OnQuantitiesClick"
                                Background="{StaticResource AccentSoftBrush}" BorderThickness="0"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsQuantityModule), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind L.T('QtyButtonTip', L.Language), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F9;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('QtyButton', L.Language), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimateSteel', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TotalSteelText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimateSteelCost', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.TotalSteelCostText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimateConcrete', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TotalConcreteText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimateGlazing', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TotalGlazingText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimatePool', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TotalPoolText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource WalletCardStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('Objects', L.Language), Mode=OneWay}" />
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.ElementCountText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource WalletCardStyle}" Background="{StaticResource AccentSoftBrush}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('EstimateTotal', L.Language), Mode=OneWay}" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.TotalCostText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsSceneEmpty), Mode=OneWay}"
                                   Text="{x:Bind L.T('EstimateEmpty', L.Language), Mode=OneWay}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SpecLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BimSpecificationLine">
                                    <Grid Padding="8,5" CornerRadius="6" ColumnSpacing="8" Background="{x:Bind local:XamlHelpers.SpecRowBackground(IsHeader)}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" MinWidth="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Item}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   FontWeight="{x:Bind local:XamlHelpers.Weight(IsHeader)}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind QuantityText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind CostText}" FontSize="12" TextAlignment="Right"
                                                   FontWeight="{x:Bind local:XamlHelpers.Weight(IsTotal)}" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════ Легенда 3D-карты напряжений (КЭ-расчёт) ═══════════════ -->
        <Border x:Name="StressLegend" Style="{StaticResource IslandStyle}" Width="296" Margin="14,0,0,16" Padding="12,10,12,12"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsStressMapEnabled), Mode=OneWay}">
            <StackPanel Spacing="8">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('StressTitle', L.Language), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.StressTimeText, Mode=OneWay}" />
                </Grid>
                <Border Style="{StaticResource SegmentTrackStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="StressMode" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsStressModeUtilization, Mode=TwoWay}" Content="{x:Bind L.T('StressModeK', L.Language), Mode=OneWay}" />
                        <RadioButton Grid.Column="1" GroupName="StressMode" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsStressModeDeflection, Mode=TwoWay}" Content="{x:Bind L.T('StressModeF', L.Language), Mode=OneWay}" />
                        <RadioButton Grid.Column="2" GroupName="StressMode" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsStressModePunching, Mode=TwoWay}" Content="{x:Bind L.T('StressModeP', L.Language), Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Шкала 0 … 1.2: синий до 0.35, изумрудный до 0.70, янтарный до 0.95, алый выше (переходы ±0.05) -->
                <Grid RowSpacing="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" /><ColumnDefinition Width="35*" /><ColumnDefinition Width="25*" /><ColumnDefinition Width="25*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" /><RowDefinition />
                    </Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="4" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#2563EB" Offset="0.25" />
                                <GradientStop Color="#10B981" Offset="0.3333" />
                                <GradientStop Color="#10B981" Offset="0.5417" />
                                <GradientStop Color="#F59E0B" Offset="0.625" />
                                <GradientStop Color="#F59E0B" Offset="0.75" />
                                <GradientStop Color="#EF4444" Offset="0.8333" />
                                <GradientStop Color="#EF4444" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="0.0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="0.35" Margin="-8,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="0.70" Margin="-8,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="0.95" Margin="-8,0,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="3" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="1.0+" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.StressScaleText, Mode=OneWay}" />

                <Grid ColumnSpacing="8" RowSpacing="3" Padding="0,2,0,0" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,6,0,0" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressMaxK', L.Language), Mode=OneWay}" />
                    <TextBlock Grid.Row="0" Margin="0,6,0,0" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{x:Bind local:XamlHelpers.ColorBrush(ViewModel.StressMaxKColor), Mode=OneWay}" Text="{x:Bind ViewModel.StressMaxKText, Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressMaxF', L.Language), Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressMaxDeflectionText, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressOverloaded', L.Language), Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressOverloadedText, Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('StressPunching', L.Language), Mode=OneWay}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.StressPunchingText, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Пилюля подсвеченной коллизии: описание и быстрое исправление ═══════════════ -->
        <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,108,0,0"
                Padding="12,6,6,6" CornerRadius="12" MaxWidth="860"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasFocusedClash), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#FF9F0A" VerticalAlignment="Center" />
                <TextBlock MaxWidth="420" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{x:Bind ViewModel.FocusedClashText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.FocusedClashText, Mode=OneWay}" />
                <Button Style="{StaticResource PillChipStyle}" Background="{StaticResource AccentSoftBrush}" Command="{x:Bind ViewModel.FixFocusedClashCommand}"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.FocusedClashHasFix), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE90F;" FontSize="11" />
                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.FocusedClashFixLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.CloseFocusedClashCommand}">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Левая плавающая панель веб-аккаунта (WebView2) ═══════════════ -->
        <views:WebAiAccountBridgePanel x:Name="WebBridgePanel" Width="470" Margin="14,62,0,16"
                                       HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                       Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsWebBridgeOpen), Mode=OneWay}" />

        <!-- ═══════════════ Панель «Инсоляция и Тени»: время суток, сезон, положение Солнца ═══════════════ -->
        <Border x:Name="SolarPanel" Style="{StaticResource IslandStyle}" Width="284" Margin="14,62,0,0" Padding="12,8,8,12" UseLayoutRounding="True"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsSolarEnabled), Mode=OneWay}">
            <StackPanel Spacing="6">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE706;" FontSize="13" Foreground="#FF9F0A" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('Solar', L.Language), Mode=OneWay}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleSolarCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
                <StackPanel Spacing="3" Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{x:Bind L.T('SolarRegion', L.Language), Mode=OneWay}" />
                    <ComboBox x:Name="SolarRegionCombo" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0"
                              Background="{StaticResource TrackBrush}" MaxDropDownHeight="320"
                              ItemsSource="{x:Bind ViewModel.SolarRegions}"
                              SelectedItem="{x:Bind ViewModel.SelectedSolarRegion, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SolarRegionOption">
                                <TextBlock FontSize="12" Text="{x:Bind Title, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Grid Margin="0,0,4,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Bottom" Text="{x:Bind L.T('SolarTime', L.Language), Mode=OneWay}" />
                    <TextBlock HorizontalAlignment="Right" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.SolarTimeText, Mode=OneWay}" />
                </Grid>
                <Slider Margin="0,-4,4,-6" Minimum="4" Maximum="22" StepFrequency="0.25" SmallChange="0.25" LargeChange="1" IsThumbToolTipEnabled="False"
                        Value="{x:Bind ViewModel.SolarHours, Mode=TwoWay}" />
                <Grid Margin="0,0,4,2">
                    <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="04:00" />
                    <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="13:00" HorizontalAlignment="Center" />
                    <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="22:00" HorizontalAlignment="Right" />
                </Grid>
                <Border Style="{StaticResource SegmentTrackStyle}" Margin="0,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="SolarSeason" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsSeasonSummer, Mode=TwoWay}" Content="{x:Bind L.T('SeasonSummer', L.Language), Mode=OneWay}" />
                        <RadioButton Grid.Column="1" GroupName="SolarSeason" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsSeasonEquinox, Mode=TwoWay}" Content="{x:Bind L.T('SeasonEquinox', L.Language), Mode=OneWay}" />
                        <RadioButton Grid.Column="2" GroupName="SolarSeason" Style="{StaticResource SegmentRadioStyle}" Padding="2,0" FontSize="11" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.IsSeasonWinter, Mode=TwoWay}" Content="{x:Bind L.T('SeasonWinter', L.Language), Mode=OneWay}" />
                    </Grid>
                </Border>
                <StackPanel Spacing="2" Margin="0,2,4,0">
                    <TextBlock FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.SolarInfoText, Mode=OneWay}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.SolarShadowText, Mode=OneWay}"
                               Visibility="{x:Bind local:XamlHelpers.VisText(ViewModel.SolarShadowText), Mode=OneWay}" />
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.SolarSiteText, Mode=OneWay}" />
                </StackPanel>

                <!-- Инсоляция окон по СанПиН: непрерывная продолжительность в расчётный день зоны (модуль) -->
                <StackPanel Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsInsolationModule), Mode=OneWay}">
                <Border Height="1" Margin="0,4,4,2" Background="{StaticResource StudioBorderBrush}" />
                <Grid Margin="0,0,4,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                   Text="{x:Bind L.T('InsolationTitle', L.Language), Mode=OneWay}" />
                        <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.InsolationNormText, Mode=OneWay}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PillChipStyle}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.CheckInsolationCommand}"
                            ToolTipService.ToolTip="{x:Bind L.T('InsolationCheckTip', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontSize="11" />
                            <TextBlock FontSize="12" Text="{x:Bind L.T('InsolationCheck', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ProgressBar IsIndeterminate="True" Margin="0,0,4,0" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsInsolationBusy), Mode=OneWay}" />
                <TextBlock FontSize="11" Margin="0,0,4,0" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{x:Bind ViewModel.InsolationSummaryText, Mode=OneWay}"
                           Visibility="{x:Bind local:XamlHelpers.VisText(ViewModel.InsolationSummaryText), Mode=OneWay}" />
                <ListView x:Name="InsolationList" MaxHeight="210" Margin="-4,0,0,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnInsolationRowClick"
                          ItemsSource="{x:Bind ViewModel.InsolationRows}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:InsolationRow">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" VerticalAlignment="Center"
                                          Foreground="{x:Bind local:XamlHelpers.PassBrush(Passes)}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock FontSize="12" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="10" Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                           Foreground="{x:Bind local:XamlHelpers.PassBrush(Passes)}" Text="{x:Bind HoursText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Пилюля 3D-армирования (модуль КЖ) ═══════════════ -->
        <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,112,0,0"
                Padding="12,6,6,6" CornerRadius="12" MaxWidth="760"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsRebarView), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="#FF7A45" VerticalAlignment="Center" />
                <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="660" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{x:Bind ViewModel.RebarInfoText, Mode=OneWay}" />
                <Button Style="{StaticResource IconButtonStyle}" Click="OnRebarCloseClick"
                        ToolTipService.ToolTip="{x:Bind L.T('Close', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Подсказка режима прогулки ═══════════════ -->
        <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0"
                Padding="12,5,6,5" CornerRadius="12" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsWalkthrough), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE805;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('WalkHint', L.Language), Mode=OneWay}" />
                <Border Width="1" Height="16" Background="{StaticResource StudioBorderBrush}" />
                <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{x:Bind ViewModel.WalkStatusText, Mode=OneWay}" />
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleWalkthroughCommand}">
                    <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════ Подсказка режима рулетки (M) ═══════════════ -->
        <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,62,0,0"
                Padding="12,5,6,5" CornerRadius="12" UseLayoutRounding="True"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsMeasureMode), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xED5E;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.MeasureHintText, Mode=OneWay}" />
                <Border Width="1" Height="16" Background="{StaticResource StudioBorderBrush}" />
                <TextBlock FontSize="11" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{x:Bind ViewModel.PinnedDimensionsText, Mode=OneWay}" />
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleMeasureCommand}">
                    <TextBlock Text="Esc" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ Боковой док Коллоквиума: колонка справа от вьюпорта (3D-холст всегда открыт, вращается и принимает клики) ═══ -->
        <Grid x:Name="CouncilDock" Grid.Column="1" Margin="0,62,14,16" UseLayoutRounding="True"
              Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsCouncilDockVisible), Mode=OneWay}">
        <Grid x:Name="CouncilDockExpanded" Width="400" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsCouncilDockExpanded), Mode=OneWay}">
        <!-- ═══ Совет КБ: лента «Ход мысли Совета» (реплики агентов: роль, модель, время ответа, найдено/исправлено) ═══ -->
        <!-- Лёгкое матовое стекло без жёсткой рамки: прозрачнее островов, мягкая тень вместо обводки -->
        <Border x:Name="CouncilTimelinePanel" Style="{StaticResource SoftGlassStyle}" Padding="12,10,8,10" UseLayoutRounding="True"
                VerticalAlignment="Stretch" Translation="0,0,24"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsCouncilTimelineVisible), Mode=OneWay}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F2;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('CouncilTimeline', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.CouncilRouteText, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ClearCouncilTimelineCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('CouncilClear', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleCouncilDockCollapsedCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('W1DockCollapse', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.CloseCouncilDockCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('W1DockClose', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" FontSize="11" TextWrapping="Wrap" Margin="2,0,8,2" Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.HasCouncilTimeline), Mode=OneWay}"
                               Text="{x:Bind L.T('CouncilEmptyTimeline', L.Language), Mode=OneWay}" />
                    <ListView x:Name="CouncilTimelineList" Grid.Row="1" VerticalAlignment="Top" SelectionMode="None" IsItemClickEnabled="False"
                              ItemsSource="{x:Bind ViewModel.CouncilTimeline}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="2,0,6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ai:AgentDebateEntry">
                                <Grid Padding="0,5" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Background="{x:Bind local:XamlHelpers.HexSoftBrush(ColorHex)}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="11" Foreground="{x:Bind local:XamlHelpers.HexBrush(ColorHex)}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind RoleTitle}" />
                                            <TextBlock FontSize="10" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       MaxWidth="196" TextTrimming="CharacterEllipsis" Text="{x:Bind ModelLabel, Mode=OneWay}"
                                                       ToolTipService.ToolTip="{x:Bind ModelLabel, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Text, Mode=OneWay}" />
                                        <!-- Внутренние рассуждения агента (deepseek-r1 и др.): мелкий полупрозрачный курсив, живой поток -->
                                        <Border Margin="0,2,0,1" Padding="8,3,8,6" CornerRadius="8" BorderThickness="2,0,0,0" UseLayoutRounding="True"
                                                Background="{StaticResource TrackBrush}" BorderBrush="{x:Bind local:XamlHelpers.HexSoftBrush(ColorHex)}"
                                                Visibility="{x:Bind local:XamlHelpers.Vis(HasReasoning), Mode=OneWay}">
                                            <StackPanel Spacing="1">
                                                <ToggleButton Style="{StaticResource IconToggleStyle}" Padding="0,0,4,0" Height="20" MinWidth="0" HorizontalAlignment="Left"
                                                              IsChecked="{x:Bind IsReasoningExpanded, Mode=TwoWay}"
                                                              ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('CouncilReasoningExpand')}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE82F;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ReasoningTitle, Mode=OneWay}" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <TextBlock FontSize="11" FontStyle="Italic" Opacity="0.62" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           MaxLines="{x:Bind local:XamlHelpers.ReasoningLines(IsReasoningExpanded), Mode=OneWay}"
                                                           Text="{x:Bind local:XamlHelpers.ReasoningPreview(Reasoning, IsReasoningExpanded), Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Border HorizontalAlignment="Left" CornerRadius="6" Padding="6,1" Background="{StaticResource TrackBrush}"
                                                Visibility="{x:Bind local:XamlHelpers.Vis(HasMetrics), Mode=OneWay}">
                                            <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind MetricsText, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                            <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsWorking, Mode=OneWay}" Visibility="{x:Bind local:XamlHelpers.Vis(IsWorking), Mode=OneWay}" />
                                            <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind local:XamlHelpers.HexBrush(StatusColorHex), Mode=OneWay}"
                                                      Visibility="{x:Bind local:XamlHelpers.VisNot(IsWorking), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock FontSize="10" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ElapsedText, Mode=OneWay}" />
                                        <TextBlock FontSize="10" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" Text="{x:Bind Time}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

        <!-- ═══ Коллоквиум: «Проверка достоверности · Лист согласования правок» (сцена внешнего генератора → локальный аудитор) ═══ -->
        <views:ColloquiumReviewPanel x:Name="ReviewPanel" VerticalAlignment="Stretch"
                                     Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsReviewOpen), Mode=OneWay}" />

        <!-- ═══ Инженерный агент: основная локальная модель, цепочка рассуждений, вызовы инструментов, отчёт (строится в MainWindow.Wave3) ═══ -->
        <Border x:Name="AgentPanelHost" Style="{StaticResource SoftGlassStyle}" Padding="12,10,6,10" UseLayoutRounding="True" VerticalAlignment="Stretch"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAgentPanelVisible), Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel x:Name="AgentPanelContent" Spacing="8" />
            </ScrollViewer>
        </Border>
        </Grid>

        <!-- Свёрнутый док: полоса 48 px с числом реплик / правок и кнопкой разворота -->
        <Border x:Name="CouncilDockStrip" Style="{StaticResource IslandStyle}" Width="48" Padding="4,8" VerticalAlignment="Top"
                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsCouncilDockStrip), Mode=OneWay}">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleCouncilDockCollapsedCommand}"
                        ToolTipService.ToolTip="{x:Bind L.T('W1DockExpand', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                </Button>
                <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" Background="{StaticResource AccentSoftBrush}">
                    <FontIcon Glyph="&#xE8F2;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{x:Bind ViewModel.CouncilDockBadge, Mode=OneWay}" />
            </StackPanel>
        </Border>
        </Grid>

        <!-- ═══════════════ Нижний док «Панель команд» BIM-Координатора (Apple Spotlight) ═══════════════ -->
        <StackPanel x:Name="AiDock" UseLayoutRounding="True" MaxWidth="780" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="14,0,14,16" Spacing="8">

            <!-- История чата и лог C#-солвера -->
            <Border Style="{StaticResource IslandStyle}" Padding="6" MaxHeight="320"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsHistoryOpen), Mode=OneWay}">
                <ListView x:Name="ChatList" SelectionMode="None" IsItemClickEnabled="False"
                          ItemsSource="{x:Bind ViewModel.ChatMessages}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessageModel">
                            <Border HorizontalAlignment="{x:Bind local:XamlHelpers.ChatAlign(IsUser)}" MaxWidth="480"
                                    Padding="10,7,10,8" CornerRadius="12"
                                    Background="{x:Bind local:XamlHelpers.ChatBubble(IsUser, IsError)}">
                                <StackPanel Spacing="4">
                                    <!-- Бейдж роли: Вы / Проектировщик / Система / Ошибка -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{x:Bind local:XamlHelpers.HexSoftBrush(RoleColorHex)}">
                                            <FontIcon Glyph="{x:Bind RoleGlyph}" FontSize="8" Foreground="{x:Bind local:XamlHelpers.HexBrush(RoleColorHex)}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind RoleTitle, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" UseLayoutRounding="True" VerticalAlignment="Center"
                                                   MaxWidth="300" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind TimeText}" FontSize="10" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" UseLayoutRounding="True"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <!-- Приложенные изображения (авто-снимок вида, поэтажный план) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind local:XamlHelpers.Vis(HasThumbnails)}">
                                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource StudioBorderBrush}">
                                            <Image Height="54" MaxWidth="96" Stretch="UniformToFill" Source="{x:Bind local:XamlHelpers.FirstThumbnail(Thumbnails)}" />
                                        </Border>
                                        <Border CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource StudioBorderBrush}" Visibility="{x:Bind local:XamlHelpers.VisCount(Thumbnails, 2)}">
                                            <Image Height="54" MaxWidth="96" Stretch="UniformToFill" Source="{x:Bind local:XamlHelpers.SecondThumbnail(Thumbnails)}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- Индикатор достоверности ответа -->
                                    <Border HorizontalAlignment="Left" CornerRadius="8" Padding="7,2,8,2" Background="{x:Bind local:XamlHelpers.HexSoftBrush(BadgeColorHex), Mode=OneWay}"
                                            Visibility="{x:Bind local:XamlHelpers.Vis(HasBadge), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE83D;" FontSize="10" Foreground="{x:Bind local:XamlHelpers.HexBrush(BadgeColorHex), Mode=OneWay}" />
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:XamlHelpers.HexBrush(BadgeColorHex), Mode=OneWay}" Text="{x:Bind Badge, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Инженерный агент: разворачиваемая «Цепочка рассуждений (N шагов · расчёт проверен)» и вызванные инструменты -->
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" MinHeight="0"
                                              Visibility="{x:Bind local:XamlHelpers.Vis(HasTrace)}"
                                              Header="{x:Bind TraceSummary}">
                                        <TextBlock Text="{x:Bind TraceDetails}" TextWrapping="Wrap" FontSize="11" UseLayoutRounding="True" IsTextSelectionEnabled="True"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Expander>
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" MinHeight="0"
                                              Visibility="{x:Bind local:XamlHelpers.Vis(HasToolCalls)}"
                                              Header="{x:Bind ToolCallsSummary}">
                                        <TextBlock Text="{x:Bind ToolCallsText}" TextWrapping="Wrap" FontSize="11" UseLayoutRounding="True" IsTextSelectionEnabled="True"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Expander>
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8" MinHeight="0"
                                              Visibility="{x:Bind local:XamlHelpers.Vis(HasReport)}"
                                              Header="{x:Bind ReportSummary}">
                                        <TextBlock Text="{x:Bind ReportDetails}" TextWrapping="Wrap" FontSize="11" UseLayoutRounding="True" IsTextSelectionEnabled="True"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <InfoBar x:Name="ErrorInfoBar" CornerRadius="12"
                     IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.ErrorSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind ViewModel.ErrorActionLabel, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="ErrorLogFlyout" Placement="Top">
                                <StackPanel Width="500" Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Opacity="0.7" Text="{x:Bind L.T('FullLog', L.Language), Mode=OneWay}" />
                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                                       Text="{x:Bind ViewModel.ErrorCode, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="OnCopyErrorLogClick" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                <TextBlock Text="{x:Bind L.T('Copy', L.Language), Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Text="{x:Bind ViewModel.ErrorReportText, Mode=OneWay}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Пилюля DXF-подложки: автоподъём в 3D и быстрое создание по выбранному контуру (режим Б) -->
            <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" CornerRadius="14" Padding="10,6,6,6"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasUnderlay), Mode=OneWay}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center" Margin="8,0,10,0" MaxWidth="260">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{x:Bind ViewModel.UnderlayTitle, Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasUnderlaySelection), Mode=OneWay}"
                                       Text="{x:Bind ViewModel.UnderlaySelectionTitle, Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.HasUnderlaySelection), Mode=OneWay}"
                                       Text="{x:Bind L.T('UnderlayPickHint', L.Language), Mode=OneWay}" />
                        </StackPanel>
                        <Border Width="1" Height="18" Margin="2,0,4,0" Background="{StaticResource StudioBorderBrush}" />
                        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.LiftUnderlayCommand}" Padding="8,0"
                                ToolTipService.ToolTip="{x:Bind L.T('UnderlayLiftFull', L.Language), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xF158;" FontSize="13" />
                                <TextBlock FontSize="12" Text="{x:Bind L.T('UnderlayLift', L.Language), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.ToggleUnderlayCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('UnderlayHide', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE7B3;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.CloseUnderlayCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('UnderlayClose', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                                Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasUnderlaySelection), Mode=OneWay}">
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="wall"
                                Content="{x:Bind L.T('MakeWall', L.Language), Mode=OneWay}" />
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="column"
                                Content="{x:Bind L.T('MakeColumn', L.Language), Mode=OneWay}" />
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="beam"
                                Content="{x:Bind L.T('MakeBeam', L.Language), Mode=OneWay}" />
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="slab"
                                Content="{x:Bind L.T('MakeSlab', L.Language), Mode=OneWay}" />
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="opening"
                                Content="{x:Bind L.T('MakeOpening', L.Language), Mode=OneWay}" />
                        <Button Style="{StaticResource PillChipStyle}" Command="{x:Bind ViewModel.UnderlayCreateCommand}" CommandParameter="axis"
                                Content="{x:Bind L.T('MakeAxis', L.Language), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Статус локального ИИ-движка Ollama (Zero-Config): «Подключение локального ИИ-движка…» → «Движок готов» -->
            <Border x:Name="OllamaStatusPill" Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" CornerRadius="12" Padding="12,6" UseLayoutRounding="True"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsOllamaToastVisible), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.OllamaStatusDetail, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsOllamaBusy, Mode=OneWay}"
                                  Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsOllamaBusy), Mode=OneWay}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:XamlHelpers.HexBrush(ViewModel.OllamaStatusColorHex), Mode=OneWay}"
                             Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsOllamaBusy), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE950;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock FontSize="12" UseLayoutRounding="True" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.OllamaStatusText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Индикатор выполнения команды -->
            <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" CornerRadius="12" Padding="12,6"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsBusy), Mode=OneWay}">
                <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="14" Height="14" />
                        <TextBlock FontSize="12" UseLayoutRounding="True" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar Width="320" Height="4" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.BusyPercent, Mode=OneWay}"
                                 Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasBusyPercent), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- ═══ Совет КБ: карточка «Согласование решения с главным инженером (Вами)» ═══ -->
            <Border x:Name="ConsultationCard" Style="{StaticResource IslandStyle}" Padding="12,10,12,12" UseLayoutRounding="True"
                    Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasConsultation), Mode=OneWay}">
                <Border.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <Thickness x:Key="TextControlThemePadding">8,5,6,5</Thickness>
                </Border.Resources>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="14" Background="#33FF9F0A" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#FF9F0A" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.ConsultationTitle, Mode=OneWay}" />
                            <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.ConsultationMeta, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.KeepAsIsCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('CouncilKeep', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{x:Bind ViewModel.ConsultationSummary, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ConsultationSummary, Mode=OneWay}" />
                    <ListView Grid.Row="2" MaxHeight="118" Margin="-4,0,-4,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCouncilIssueClick"
                              ItemsSource="{x:Bind ViewModel.ConsultationIssues}">
                        <ListView.Header>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="6,0,0,4" Text="{x:Bind L.T('CouncilIssues', L.Language), Mode=OneWay}" />
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConsultationIssueRow">
                                <Grid Padding="0,3" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Explanation}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="11" Foreground="{x:Bind local:XamlHelpers.SeverityBrush(Critical)}" />
                                    <TextBlock Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Title}" />
                                    <Border Grid.Column="2" CornerRadius="6" Padding="6,1" Background="{StaticResource TrackBrush}">
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Category}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,0" Text="{x:Bind L.T('CouncilVariants', L.Language), Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ConsultationVariants}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsultationVariantRow">
                                    <Button Style="{StaticResource CardButtonStyle}" Tag="{x:Bind}" Click="OnCouncilVariantClick">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Top" Background="{x:Bind local:XamlHelpers.HexSoftBrush(ColorHex)}">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{x:Bind local:XamlHelpers.HexBrush(ColorHex)}" Text="{x:Bind Badge}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind local:XamlHelpers.HexBrush(ColorHex)}" Text="{x:Bind Author}" />
                                                    <Border CornerRadius="6" Padding="6,0" Background="{StaticResource AccentSoftBrush}" Visibility="{x:Bind local:XamlHelpers.Vis(Recommended)}">
                                                        <TextBlock FontSize="10" Foreground="{StaticResource AccentBrush}" Text="{x:Bind local:XamlHelpers.Text('CouncilRecommended')}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Title}" />
                                                <TextBlock FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Description}" />
                                                <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Metrics}"
                                                           Visibility="{x:Bind local:XamlHelpers.VisEngineer(Metrics)}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Grid.Row="4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="10" Background="{StaticResource TrackBrush}">
                            <TextBox x:Name="ConsultationReplyBox" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="False"
                                     PlaceholderText="{x:Bind L.T('CouncilReplyPlaceholder', L.Language), Mode=OneWay}"
                                     Text="{x:Bind ViewModel.ConsultationReply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnConsultationReplyKeyDown" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource SendButtonStyle}" VerticalAlignment="Center" Command="{x:Bind ViewModel.SendConsultationReplyCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('CouncilReplySend', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PillChipStyle}" VerticalAlignment="Center" Command="{x:Bind ViewModel.KeepAsIsCommand}"
                                Content="{x:Bind L.T('CouncilKeep', L.Language), Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Волна 7: чипы журнала, локального ядра, веб-аккаунта и вложений перенесены в меню ассистента (кнопка в капсуле ввода);
                 элементы остаются как опоры их всплывающих окон -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.ToggleHistoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81C;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.HistoryLabel, Mode=OneWay}" UseLayoutRounding="True" />
                    </StackPanel>
                </Button>
                <!-- Локальное ядро: основная локальная модель программы (рейтинг, скорость, автовыбор) — Flyout строится в MainWindow.Wave3 -->
                <Button x:Name="PrimaryModelChipButton" Style="{StaticResource ChipButtonStyle}" MaxWidth="390"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryModelChip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind local:XamlHelpers.HexBrush(ViewModel.PrimaryModelColorHex), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE950;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.PrimaryModelChip, Mode=OneWay}" TextTrimming="CharacterEllipsis" UseLayoutRounding="True"
                                   Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsAgentMode), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PrimaryModelRatingShort, Mode=OneWay}" UseLayoutRounding="True"
                                   Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.ToggleWebBridgeCommand}"
                        ToolTipService.ToolTip="{x:Bind L.T('WebOpenPanel', L.Language), Mode=OneWay}">
                    <FontIcon Glyph="&#xE774;" FontSize="12" />
                </Button>
                <!-- Визуальный контекст запроса: авто-снимок вида и план / эскиз — без снимков экрана и Ctrl+V -->
                <Border Style="{StaticResource IslandStyle}" CornerRadius="14" Padding="2" UseLayoutRounding="True"
                        Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}">
                    <ToggleButton Style="{StaticResource IconToggleStyle}" Height="24" Padding="10,0" CornerRadius="12" IsChecked="{x:Bind ViewModel.IsAutoSnapshot, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('AttachAutoTip', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE722;" FontSize="12" />
                            <TextBlock FontSize="12" FontWeight="Medium" Text="{x:Bind L.T('AttachAuto', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>
                </Border>
                <Button Style="{StaticResource ChipButtonStyle}" Command="{x:Bind ViewModel.AttachFileCommand}"
                        Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind L.T('AttachFile', L.Language), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE723;" FontSize="12" />
                        <TextBlock Text="{x:Bind L.T('AttachFile', L.Language), Mode=OneWay}" UseLayoutRounding="True" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ═══ Совет КБ: режим «1 Агент | Совет КБ», состав бюро, ход мысли и аудит текущей сцены ═══ -->
            <Border x:Name="CouncilBar" Style="{StaticResource IslandStyle}" HorizontalAlignment="Center" CornerRadius="14" Padding="4" UseLayoutRounding="True" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Style="{StaticResource SegmentTrackStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="AgentMode" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11" Height="24"
                                         IsChecked="{x:Bind ViewModel.IsSingleAgentMode, Mode=TwoWay}" Content="{x:Bind L.T('CouncilSingle', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="AgentMode" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11" Height="24"
                                         IsChecked="{x:Bind ViewModel.IsCouncilMode, Mode=TwoWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('CouncilModeTip', L.Language), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE716;" FontSize="11" />
                                    <TextBlock Text="{x:Bind L.T('CouncilMulti', L.Language), Mode=OneWay}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AgentModeRadio" GroupName="AgentMode" Style="{StaticResource SegmentRadioStyle}" Padding="8,0" FontSize="11" Height="24"
                                         IsChecked="{x:Bind ViewModel.IsAgentMode, Mode=TwoWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('W3AgentModeTip', L.Language), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE90F;" FontSize="11" />
                                    <TextBlock Text="{x:Bind L.T('W3AgentModeShort', L.Language), Mode=OneWay}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Button x:Name="CouncilTeamButton" Style="{StaticResource IconButtonStyle}" Padding="8,0" Height="28"
                            ToolTipService.ToolTip="{x:Bind L.T('CouncilTeamTitle', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE902;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock FontSize="12" Text="{x:Bind L.T('CouncilTeam', L.Language), Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="CouncilTeamFlyout" Placement="Top" FlyoutPresenterStyle="{StaticResource CouncilFlyoutPresenterStyle}" Opening="OnCouncilFlyoutOpening">
                                <StackPanel Width="520" Spacing="10">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE902;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('CouncilTeamTitle', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('CouncilTeamHint', L.Language), Mode=OneWay}" />
                                    </StackPanel>
                                    <!-- Локальный ИИ-движок Ollama: статус, версия, число моделей, обновление списка -->
                                    <Border CornerRadius="10" Padding="10,6,6,6" Background="{StaticResource TrackBrush}" UseLayoutRounding="True">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="30" Height="30">
                                                <Border CornerRadius="15" Background="{x:Bind local:XamlHelpers.HexSoftBrush(ViewModel.OllamaStatusColorHex), Mode=OneWay}" />
                                                <FontIcon Glyph="&#xE950;" FontSize="13" Foreground="{x:Bind local:XamlHelpers.HexBrush(ViewModel.OllamaStatusColorHex), Mode=OneWay}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('OllamaSectionTitle', L.Language), Mode=OneWay}" />
                                                <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{x:Bind ViewModel.OllamaShortText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.OllamaStatusDetail, Mode=OneWay}" />
                                            </StackPanel>
                                            <ProgressRing Grid.Column="2" Width="14" Height="14" Margin="0,0,8,0" IsActive="{x:Bind ViewModel.IsOllamaBusy, Mode=OneWay}"
                                                          Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsOllamaBusy), Mode=OneWay}" />
                                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Command="{x:Bind ViewModel.RefreshOllamaCommand}"
                                                    Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsOllamaBusy), Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind L.T('OllamaRefresh', L.Language), Mode=OneWay}">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CouncilSlots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CouncilRoleSlot">
                                                <Border CornerRadius="10" Padding="10,8" Background="{StaticResource TrackBrush}">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="232" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center" Background="{x:Bind local:XamlHelpers.HexSoftBrush(ColorHex)}">
                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{x:Bind local:XamlHelpers.HexBrush(ColorHex)}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                            <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind Title, Mode=OneWay}" />
                                                            <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Description, Mode=OneWay}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                            <ComboBox HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0" MaxDropDownHeight="360"
                                                                      Background="{StaticResource HoverBrush}"
                                                                      ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:CouncilModelChoice">
                                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="11" />
                                                                            <TextBlock FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" Text="{x:Bind Title}" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{x:Bind ResolvedText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ResolvedText, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE968;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock FontSize="11" Width="490" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.CouncilRouteText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource PanelButtonStyle}" Command="{x:Bind ViewModel.AutoAssignCouncilCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE945;" FontSize="12" />
                                            <TextBlock Text="{x:Bind L.T('CouncilAutoAssign', L.Language), Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource SegmentTrackStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton GroupName="CouncilConsult" Style="{StaticResource SegmentRadioStyle}" FontSize="11" HorizontalAlignment="Stretch"
                                                         IsChecked="{x:Bind ViewModel.IsCouncilConsult, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8F2;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind L.T('CouncilConsult', L.Language), Mode=OneWay}" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton Grid.Column="1" GroupName="CouncilConsult" Style="{StaticResource SegmentRadioStyle}" FontSize="11" HorizontalAlignment="Stretch"
                                                         IsChecked="{x:Bind ViewModel.IsCouncilAutopilot, Mode=TwoWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE945;" FontSize="11" />
                                                    <TextBlock Text="{x:Bind L.T('CouncilAutopilot', L.Language), Mode=OneWay}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                    </Border>
                                    <CheckBox FontSize="12" MinHeight="24" IsChecked="{x:Bind ViewModel.IsCouncilAiComments, Mode=TwoWay}"
                                              Content="{x:Bind L.T('CouncilAiComments', L.Language), Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <ToggleButton Style="{StaticResource IconToggleStyle}" Padding="8,0" Height="28" IsChecked="{x:Bind ViewModel.IsCouncilTimelineOpen, Mode=TwoWay}"
                                  Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind L.T('CouncilTimeline', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F2;" FontSize="12" />
                            <TextBlock FontSize="12" Text="{x:Bind ViewModel.CouncilTimelineLabel, Mode=OneWay}" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Width="1" Height="18" Margin="2,0" VerticalAlignment="Center" Background="{StaticResource StudioBorderBrush}"
                            Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}" />

                    <Button Style="{StaticResource PillChipStyle}" Height="28" Background="{StaticResource AccentSoftBrush}" Command="{x:Bind ViewModel.RunCouncilAuditCommand}"
                            Visibility="{x:Bind local:XamlHelpers.VisNot(ViewModel.IsAgentMode), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('CouncilAuditTip', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock FontSize="12" Text="{x:Bind L.T('CouncilAudit', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Индикатор достоверности последнего ответа и навигация по версиям сцены (шаги журнала транзакций) -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IslandStyle}" HorizontalAlignment="Left" CornerRadius="13" Padding="10,4,12,4" UseLayoutRounding="True"
                        Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasVerificationBadge), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <ProgressRing Width="12" Height="12" IsActive="{x:Bind ViewModel.IsReviewBusy, Mode=OneWay}" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsReviewBusy), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE83D;" FontSize="12" Foreground="{x:Bind local:XamlHelpers.HexBrush(ViewModel.VerificationBadgeColorHex), Mode=OneWay}" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="330"
                                   Foreground="{x:Bind local:XamlHelpers.HexBrush(ViewModel.VerificationBadgeColorHex), Mode=OneWay}" Text="{x:Bind ViewModel.VerificationBadgeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border x:Name="VersionCapsule" Grid.Column="1" Style="{StaticResource IslandStyle}" CornerRadius="13" Padding="2" UseLayoutRounding="True">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="HistoryButton" Style="{StaticResource IconButtonStyle}" Height="24" MinWidth="24" Padding="6,0" CornerRadius="11" Click="OnHistoryClick"
                                ToolTipService.ToolTip="{x:Bind L.T('HistoryTip', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE81C;" FontSize="11" />
                        </Button>
                        <Border Width="1" Height="14" Margin="1,0" Background="{StaticResource StudioBorderBrush}" />
                        <Button Style="{StaticResource IconButtonStyle}" Height="24" MinWidth="24" Padding="6,0" CornerRadius="11" Command="{x:Bind ViewModel.VersionBackCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('VersionBack', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE76B;" FontSize="10" />
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="2,0" Background="Transparent" Tapped="OnVersionTapped"
                                    ToolTipService.ToolTip="{x:Bind L.T('VersionOpenHistory', L.Language), Mode=OneWay}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" />
                            <TextBlock FontSize="9" HorizontalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind ViewModel.VersionDetail, Mode=OneWay}" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButtonStyle}" Height="24" MinWidth="24" Padding="6,0" CornerRadius="11" Command="{x:Bind ViewModel.VersionForwardCommand}"
                                ToolTipService.ToolTip="{x:Bind L.T('VersionForward', L.Language), Mode=OneWay}">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Капсула ввода -->
            <Border x:Name="PromptCapsule" Style="{StaticResource IslandStyle}" CornerRadius="18" Padding="10,6">
                <Border.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    <Thickness x:Key="TextControlThemePadding">6,5,6,5</Thickness>
                </Border.Resources>
                <StackPanel Spacing="6">
                <!-- Миниатюры вложений: авто-снимок 3D-вида и прикреплённые планы (убрать, обновить кадр) -->
                <Grid ColumnSpacing="8" Margin="2,2,2,0" Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.HasAttachments), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ai:RequestAttachment">
                                <Grid Width="76" Height="50" ToolTipService.ToolTip="{x:Bind Title}">
                                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource StudioBorderBrush}" Background="{StaticResource TrackBrush}">
                                        <Image Stretch="UniformToFill" Source="{x:Bind local:XamlHelpers.Thumbnail(Bytes)}" />
                                    </Border>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3" CornerRadius="4" Padding="4,0,4,1" Background="#A0000000">
                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White" Text="{x:Bind local:XamlHelpers.AttachmentKindText(Kind)}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Spacing="2">
                                        <Button Width="18" Height="18" MinWidth="0" Padding="0" CornerRadius="9" Background="#A0000000" BorderThickness="0" Tag="{x:Bind}" Click="OnAttachmentRefreshClick"
                                                Visibility="{x:Bind local:XamlHelpers.Vis(IsAuto)}" ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('AttachRefresh')}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="8" Foreground="White" />
                                        </Button>
                                        <Button Width="18" Height="18" MinWidth="0" Padding="0" CornerRadius="9" Background="#A0000000" BorderThickness="0" Tag="{x:Bind}" Click="OnAttachmentRemoveClick"
                                                ToolTipService.ToolTip="{x:Bind local:XamlHelpers.Text('AttachRemove')}">
                                            <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FF9F0A" Text="{x:Bind ViewModel.AttachmentsHint, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Режим работы ассистента: Проектировщик / Совет КБ / Агент; меню — состав бюро, протокол, аудит, журнал, вложения -->
                    <Button x:Name="AssistantButton" Grid.Column="0" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" CornerRadius="14" Padding="8,0,6,0"
                            ToolTipService.ToolTip="{x:Bind L.T('W7AssistantTip', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="{x:Bind ViewModel.AssistantModeGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AssistantModeTitle, Mode=OneWay}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="AssistantFlyout" Placement="TopEdgeAlignedLeft" Opening="OnAssistantFlyoutOpening" />
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" CornerRadius="14"
                            ToolTipService.ToolTip="{x:Bind L.T('FromImage', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xEB9F;" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuFlyoutItem Tag="VisionPlan" Click="OnVisionClick" Text="{x:Bind L.T('VisionPlan', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="VisionSketch" Click="OnVisionClick" Text="{x:Bind L.T('VisionSketch', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEE56;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Tag="VisionPhoto" Click="OnVisionClick" Text="{x:Bind L.T('VisionPhoto', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE722;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Tag="VisionDrawings" Click="OnVisionClick" Text="{x:Bind L.T('VisionDrawings', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA90;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ReconstructFromPlanCommand}" Text="{x:Bind L.T('PlanReconstruct', L.Language), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80A;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBox x:Name="ChatInputBox" Grid.Column="2" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" FontSize="14" FontWeight="Medium" UseLayoutRounding="True"
                             VerticalAlignment="Center"
                             PlaceholderText="{x:Bind ViewModel.ChatPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.ChatInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnChatInputPreviewKeyDown" />

                    <Button x:Name="ModelButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" Padding="8,0,6,0"
                            ToolTipService.ToolTip="{x:Bind L.T('AiModel', L.Language), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="{x:Bind ViewModel.SelectedAiModelGlyph, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAiModelShort, Mode=OneWay}" FontSize="13" FontWeight="Medium" UseLayoutRounding="True" Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                            <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="ModelFlyout" Placement="TopEdgeAlignedRight" Opening="OnModelFlyoutOpening" />
                        </Button.Flyout>
                    </Button>

                    <Border Grid.Column="4" Style="{StaticResource SegmentTrackStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="SceneMode" Style="{StaticResource SegmentRadioStyle}" Padding="9,0" FontSize="11" Height="24" UseLayoutRounding="True"
                                         IsChecked="{x:Bind ViewModel.IsNewSceneMode, Mode=TwoWay}"
                                         Content="{x:Bind L.T('ModeNewShort', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('ModeNewScene', L.Language), Mode=OneWay}" />
                            <RadioButton GroupName="SceneMode" Style="{StaticResource SegmentRadioStyle}" Padding="9,0" FontSize="11" Height="24" UseLayoutRounding="True"
                                         IsChecked="{x:Bind ViewModel.IsAppendMode, Mode=TwoWay}"
                                         Content="{x:Bind L.T('ModeAppendShort', L.Language), Mode=OneWay}"
                                         ToolTipService.ToolTip="{x:Bind L.T('ModeAppend', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="5" Style="{StaticResource SendButtonStyle}" VerticalAlignment="Center" Margin="4,0,0,0"
                            Command="{x:Bind ViewModel.SendChatCommand}"
                            Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsIdle), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('Send', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource SendButtonStyle}" VerticalAlignment="Center" Margin="4,0,0,0"
                            Command="{x:Bind ViewModel.CancelAiCommand}"
                            Visibility="{x:Bind local:XamlHelpers.Vis(ViewModel.IsBusy), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind L.T('CancelAi', L.Language), Mode=OneWay}">
                        <FontIcon Glyph="&#xE71A;" FontSize="11" />
                    </Button>
                </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
