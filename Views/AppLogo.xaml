<?xml version="1.0" encoding="utf-8"?>
<!-- Знак Architect Studio Pro: строгий векторный чертёж здания — изометрическая призма с линиями этажей, координационными осями
     и размерной линией на скруглённой графитово-синей плитке. Чистый вектор, масштабируется Viewbox. -->
<UserControl
    x:Class="AIArchitectStudio.Views.AppLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="120" Height="120">
            <Rectangle Width="120" Height="120" RadiusX="28" RadiusY="28">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#2C7BE5" />
                        <GradientStop Offset="0.6" Color="#0A5AD6" />
                        <GradientStop Offset="1" Color="#1C3F8F" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Блик верхней кромки плитки -->
            <Rectangle Width="120" Height="120" RadiusX="28" RadiusY="28">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,0.6">
                        <GradientStop Offset="0" Color="#30FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Координационные оси чертежа (штрихпунктир) с марками в кружках -->
            <Path Stroke="#59FFFFFF" StrokeThickness="1" StrokeDashArray="6,2,1,2"
                  Data="M32,16 L32,104 M88,16 L88,104 M14,90 L106,90" />
            <Ellipse Canvas.Left="27" Canvas.Top="8" Width="10" Height="10" Stroke="#8CFFFFFF" StrokeThickness="1" />
            <Ellipse Canvas.Left="83" Canvas.Top="8" Width="10" Height="10" Stroke="#8CFFFFFF" StrokeThickness="1" />

            <!-- Призма здания: верх, левая и правая грани -->
            <Path Data="M60,26 L88,42 L60,58 L32,42 Z" Fill="#FFFFFFFF" />
            <Path Data="M32,42 L60,58 L60,98 L32,82 Z" Fill="#D9FFFFFF" />
            <Path Data="M60,58 L88,42 L88,82 L60,98 Z" Fill="#A6FFFFFF" />
            <!-- Линии этажей и рёбра -->
            <Path Stroke="#660A5AD6" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M32,52 L60,68 M32,62 L60,78 M32,72 L60,88 M60,68 L88,52 M60,78 L88,62 M60,88 L88,72 M60,58 L60,98" />

            <!-- Размерная линия по низу с засечками 45° -->
            <Path Stroke="#BFFFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M28,108 L92,108 M29.5,110.5 L34.5,105.5 M85.5,110.5 L90.5,105.5 M32,104 L32,111 M88,104 L88,111" />
        </Canvas>
    </Viewbox>
</UserControl>
