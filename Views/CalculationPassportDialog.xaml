<?xml version="1.0" encoding="utf-8"?>
<!-- «Обоснование расчёта по СП»: паспорт несущего элемента — сводка и вердикт, паспорт материала с источником характеристик,
     сбор нагрузок и граничные условия, пошаговый расчёт с формулами и пунктами СП; копирование расчётной записки и правка
     характеристик материала (сертификат элемента или класса проекта). -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.CalculationPassportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    PrimaryButtonClick="OnCopyClick"
    SecondaryButtonClick="OnMaterialClick"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Style x:Key="PassportCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12,16,12" />
        </Style>
        <Style x:Key="SectionNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="820" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Шапка: элемент и вердикт -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border x:Name="VerdictPill" Grid.Column="2" CornerRadius="12" Padding="14,6,14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="VerdictText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="GoverningText" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="KValueText" FontSize="28" FontWeight="SemiBold" CharacterSpacing="-20" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Правка характеристик материала: сертификат элемента или класса проекта -->
        <Border x:Name="MaterialEditor" Grid.Row="1" Style="{StaticResource PassportCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EditorTitle" Grid.Column="1" Style="{StaticResource SectionTitleStyle}" />
                    <Border Grid.Column="2" Style="{StaticResource SegmentTrackStyle}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ScopeElementRadio" GroupName="CertScope" Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Checked="OnScopeChecked" />
                            <RadioButton x:Name="ScopeClassRadio" GroupName="CertScope" Style="{StaticResource SegmentRadioStyle}" Checked="OnScopeChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="StrengthLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource CardBrush}">
                            <TextBox x:Name="StrengthBox" FontSize="13" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" InputScope="Number" MinHeight="28" Padding="8,4,8,4" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="ModulusLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource CardBrush}">
                            <TextBox x:Name="ModulusBox" FontSize="13" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" InputScope="Number" MinHeight="28" Padding="8,4,8,4" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock x:Name="DensityLabel" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Border Style="{StaticResource CoordinateFieldStyle}" Background="{StaticResource CardBrush}">
                            <TextBox x:Name="DensityBox" FontSize="13" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" InputScope="Number" MinHeight="28" Padding="8,4,8,4" />
                        </Border>
                    </StackPanel>
                    <Button x:Name="ApplyCertificateButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" Click="OnApplyCertificateClick" />
                    <Button x:Name="ResetCertificateButton" Grid.Column="4" VerticalAlignment="Bottom" CornerRadius="8" Click="OnResetCertificateClick" />
                </Grid>
                <TextBlock x:Name="EditorHint" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel x:Name="Body" Spacing="12" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
