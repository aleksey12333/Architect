<?xml version="1.0" encoding="utf-8"?>
<!-- Окно «Градостроительные ограничения и ЗОУИТ» (Liquid Glass): этапы глубокого анализа документа, ведомость ограничений с
     цитатами и страницами, сведения по разделам, сверка полноты; действия «Принять» / «Исключить условие» / «Изменить параметры».
     Содержимое строится в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.ConstraintVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="16"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="Root" Width="1180" Height="760" RowSpacing="12" />
</ContentDialog>
