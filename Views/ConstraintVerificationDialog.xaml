<?xml version="1.0" encoding="utf-8"?>
<!-- Окно подтверждения ограничений и «НО» документа / интернета в стиле Liquid Glass: по каждому пункту — наименование, значение для
     ядра, источник и цитата, действия «Подтвердить» / «Отклонить — ИИ перепутал» (повторный поиск с уточнением или ручная правка).
     Содержимое строится в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.ConstraintVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="16"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="Root" Width="1180" Height="760" RowSpacing="12" />
</ContentDialog>
