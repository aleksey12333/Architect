<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AIArchitectStudio.Views.DxfLiftDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <Style x:Key="LiftBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,5,8,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LiftLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="LiftTimesStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LiftFactStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="740" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка: файл, единицы, габарит -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE81E;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="HeaderText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Распознано в чертеже -->
            <Border CornerRadius="12" Padding="12,10" BorderThickness="1" Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource StudioBorderBrush}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="FactsTitle" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="FactsText" Style="{StaticResource LiftFactStyle}" LineHeight="17" />
                    <Rectangle Height="1" Fill="{StaticResource StudioBorderBrush}" Margin="0,2" />
                    <TextBlock x:Name="FlatHint" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Параметры подъёма -->
            <Border Grid.Column="1" CornerRadius="12" Padding="14,10" BorderThickness="1" Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource StudioBorderBrush}">
                <StackPanel Spacing="9">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="BaseLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="BaseBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LevelLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="LevelBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="WallLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="WallBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SlabLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="SlabBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FoundationLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="FoundationBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="RoofLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="RoofBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource StudioBorderBrush}" />

                    <StackPanel>
                        <TextBlock x:Name="ColumnLabel" Style="{StaticResource LiftLabelStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ColumnModeBox" HorizontalAlignment="Stretch" MinHeight="28" CornerRadius="6" FontSize="12" SelectionChanged="OnModeChanged" />
                            <TextBox x:Name="ColumnWBox" Grid.Column="1" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                            <TextBlock Grid.Column="2" Style="{StaticResource LiftTimesStyle}" Text="×" />
                            <TextBox x:Name="ColumnDBox" Grid.Column="3" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="BeamLabel" Style="{StaticResource LiftLabelStyle}" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="BeamModeBox" HorizontalAlignment="Stretch" MinHeight="28" CornerRadius="6" FontSize="12" SelectionChanged="OnModeChanged" />
                            <TextBox x:Name="BeamWBox" Grid.Column="1" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                            <TextBlock Grid.Column="2" Style="{StaticResource LiftTimesStyle}" Text="×" />
                            <TextBox x:Name="BeamHBox" Grid.Column="3" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </Grid>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="WindowLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="WindowBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SillLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="SillBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="DoorLabel" Style="{StaticResource LiftLabelStyle}" />
                            <TextBox x:Name="DoorBox" Style="{StaticResource LiftBoxStyle}" TextChanged="OnFieldChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Итог проверки -->
        <Border Grid.Row="2" Padding="10,8" CornerRadius="10" Background="{StaticResource HoverBrush}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="StatusGlyph" Glyph="&#xE73E;" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
