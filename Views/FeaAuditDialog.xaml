<?xml version="1.0" encoding="utf-8"?>
<!-- «Аудит расчётной схемы»: баланс вертикальных сил, пять критериев логики КЭ-расчёта, таблицы напряжений σ / τ (МПа) и узлов
     продавливания. Содержимое строится в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.FeaAuditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <Grid Width="880" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="VerdictBadge" Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon x:Name="VerdictGlyph" Glyph="&#xE9F5;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="TilesGrid" Grid.Row="1" ColumnSpacing="10" />

        <ScrollViewer Grid.Row="2" Height="540" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel x:Name="BodyPanel" Spacing="10" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
