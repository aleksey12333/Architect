<?xml version="1.0" encoding="utf-8"?>
<!-- «Градостроительный план (ГПЗУ) и охранные зоны» в стиле Liquid Glass: слева — кадастровый паспорт, регламент, слои и
     охранные зоны с тумблерами, ведомость координат выбранной зоны, проверка посадки и экспертиза через модель; справа —
     масштабируемый векторный чертёж участка (точки 1…N, цветные зоны, сети топосъёмки, сетка МСК, «Север», легенда);
     внизу — загрузка документов, выпуск чертежа ГОСТ и перенос участка в 3D-сцену. Содержимое строится в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.GpzuStudioDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="16"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1560</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="Root" Width="1480" Height="860" RowSpacing="12" />
</ContentDialog>
