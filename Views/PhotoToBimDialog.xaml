<?xml version="1.0" encoding="utf-8"?>
<!-- «Реконструкция по фото и плану»: источник снимка (ссылка, файл, буфер обмена, перетаскивание), выбор модели подъёма,
     слева — снимок с оверлеями Визуального ядра (силуэт, ярусы, этажи, кривизна, палитра), справа — вращаемое 3D-превью BIM-модели
     в цветах снимка со сводкой проверки каркаса, ниже — профиль, этажность, кривизна, остекление, покрытие. Содержимое — в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.PhotoToBimDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    AllowDrop="True"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">980</x:Double>
    </ContentDialog.Resources>

    <Grid x:Name="Root" Width="1240" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Grid x:Name="HeaderHost" />
        <Grid x:Name="SourceHost" Grid.Row="1" />
        <Grid x:Name="BodyHost" Grid.Row="2" />
        <Grid x:Name="ControlsHost" Grid.Row="3" />
        <StackPanel x:Name="FooterHost" Grid.Row="4" Spacing="4" />
    </Grid>
</ContentDialog>
