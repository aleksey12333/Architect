<?xml version="1.0" encoding="utf-8"?>
<!-- «Реконструкция здания по поэтажному плану»: предпросмотр собранного 3D-каркаса (изометрия) и нормализованного плана,
     сводка распознанного (оси, наружные/внутренние стены, проёмы, колонны, плиты), масштаб, постобработка и конструктивная
     целостность (K_исп, опоры, армирование); этажность, высота этажа и калибровочный размер — «Пересобрать». -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.PlanToBimDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
        <Style x:Key="PlanCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10,14,12" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="880" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Шапка: план и вердикт целостности -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE80A;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border x:Name="VerdictPill" Grid.Column="2" CornerRadius="12" Padding="14,6,14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VerdictText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="VerdictDetail" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="KValueText" FontSize="28" FontWeight="SemiBold" CharacterSpacing="-20" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="316" />
            </Grid.ColumnDefinitions>

            <!-- Предпросмотр: 3D-каркас (изометрия) | нормализованный план -->
            <Border Style="{StaticResource PlanCardStyle}" Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="View3DRadio" GroupName="PlanPreview" Style="{StaticResource SegmentRadioStyle}" Padding="12,0" FontSize="11" Height="24" Checked="OnPreviewModeChecked" />
                                <RadioButton x:Name="ViewPlanRadio" GroupName="PlanPreview" Style="{StaticResource SegmentRadioStyle}" Padding="12,0" FontSize="11" Height="24" Checked="OnPreviewModeChecked" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SizeText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="1" Height="470">
                        <Canvas x:Name="PreviewCanvas" />
                        <!-- Вставка: исходное изображение плана -->
                        <Border x:Name="SourceInset" Width="168" Height="120" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#FFFFFFFF"
                                BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" Padding="3">
                            <Image x:Name="SourceImage" Stretch="Uniform" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Сводка распознанного и параметры -->
            <ScrollViewer Grid.Column="1" MaxHeight="512" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource PlanCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RecognizedTitle" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel x:Name="CountsPanel" Spacing="3" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PlanCardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="ScaleTitle" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,2" />
                                <TextBlock x:Name="ScaleText" FontSize="11" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="NormalizationTitle" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,2" />
                                <TextBlock x:Name="NormalizationText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="1">
                                <TextBlock x:Name="IntegrityTitle" Style="{StaticResource SectionHeaderStyle}" Margin="2,0,0,2" />
                                <TextBlock x:Name="IntegrityText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="SizingText" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PlanCardStyle}">
                        <Grid ColumnSpacing="8" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="StoreysLabel" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <NumberBox x:Name="StoreysBox" Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="1" Maximum="40" SmallChange="1" Value="2" />
                            <TextBlock x:Name="FloorHeightLabel" Grid.Row="1" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                            <NumberBox x:Name="FloorHeightBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="2400" Maximum="6000" SmallChange="100" Value="3000" />
                            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                <TextBlock x:Name="CalibrationLabel" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="CalibrationHint" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <NumberBox x:Name="CalibrationBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource CoordinateNumberBoxStyle}" Minimum="0" Maximum="300000" SmallChange="100" Value="0" />
                            <Button x:Name="RebuildButton" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource PanelButtonStyle}" Click="OnRebuildClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock x:Name="RebuildText" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
