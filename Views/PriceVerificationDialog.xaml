<?xml version="1.0" encoding="utf-8"?>
<!-- «Веб-импорт прайса по ссылке» и «Проверка подтянутых расценок — всё ли верно?»: этап 1 — источники (ссылки на магазины, прошлые
     проекты и сметы, вставленный текст, индексация), этап 2 — таблица найденных позиций со старой и новой ценой, Δ, магазином и
     достоверностью, сводка «Было → Станет» по стоимости каркаса и вопрос-подтверждение. Содержимое строится в code-behind. -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.PriceVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1240</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">940</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1150" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon x:Name="HeaderGlyph" Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
        </Grid>

        <ScrollViewer Grid.Row="1" Height="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel x:Name="BodyPanel" Spacing="10" />
        </ScrollViewer>

        <StackPanel x:Name="FooterPanel" Grid.Row="2" Spacing="6" />
    </Grid>
</ContentDialog>
