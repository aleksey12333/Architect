<?xml version="1.0" encoding="utf-8"?>
<!-- «Ведомость объёмов»: стеклянное окно со сводкой по 3D-модели — бетон по конструкциям, арматура по классам, остекление, прокат —
     и смета-калькулятор монолитного каркаса (цены бетона и арматуры, итог, сохранение в проект). -->
<ContentDialog
    x:Class="AIArchitectStudio.Views.QuantityScheduleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    CornerRadius="14"
    Background="{StaticResource IslandBrush}"
    BorderBrush="{StaticResource StudioBorderBrush}"
    BorderThickness="1"
    PrimaryButtonClick="OnCopyClick"
    SecondaryButtonClick="OnSaveEstimateClick"
    UseLayoutRounding="True">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <!-- Поля цен — без системной рамки и подложки (как поля координат инспектора) -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="-10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="KpiUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10,14,8" />
        </Style>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="920" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Приёмник начального фокуса: поля цен не получают фокус (и кнопку очистки) при открытии окна -->
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Шапка -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE9F9;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Вид таблиц: по конструкциям | по свойствам пользователя (сегмент виден, если свойства заданы хотя бы у одного элемента) -->
            <Border x:Name="ViewSwitch" Grid.Column="2" Style="{StaticResource SegmentTrackStyle}" VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MembersViewButton" GroupName="QtyView" Style="{StaticResource SegmentRadioStyle}" IsChecked="True" Checked="OnViewChecked" />
                    <RadioButton x:Name="ParamsViewButton" GroupName="QtyView" Style="{StaticResource SegmentRadioStyle}" Checked="OnViewChecked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Итоги: бетон, арматура, остекление, прокат -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource WalletCardStyle}" Background="{StaticResource AccentSoftBrush}" Padding="14,10">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B8;" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="ConcreteCaption" Style="{StaticResource FieldLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ConcreteValue" Style="{StaticResource KpiValueStyle}" />
                    <TextBlock x:Name="ConcreteUnit" Style="{StaticResource KpiUnitStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource WalletCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A9;" FontSize="11" Foreground="#FF7A45" />
                        <TextBlock x:Name="RebarCaption" Style="{StaticResource FieldLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="RebarValue" Style="{StaticResource KpiValueStyle}" />
                    <TextBlock x:Name="RebarUnit" Style="{StaticResource KpiUnitStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource WalletCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" FontSize="11" Foreground="#64D2FF" />
                        <TextBlock x:Name="GlazingCaption" Style="{StaticResource FieldLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="GlazingValue" Style="{StaticResource KpiValueStyle}" />
                    <TextBlock x:Name="GlazingUnit" Style="{StaticResource KpiUnitStyle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource WalletCardStyle}" Padding="14,10">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="#8E8E93" />
                        <TextBlock x:Name="RolledCaption" Style="{StaticResource FieldLabelStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="RolledValue" Style="{StaticResource KpiValueStyle}" />
                    <TextBlock x:Name="RolledUnit" Style="{StaticResource KpiUnitStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Доказательная смета каркаса: база цен (расценки проекта или прайс поставщика), позиции с поставщиком, документом-основанием,
             ценой и суммой; цена и поставщик правятся прямо в строке, итог пересчитывается на каждое нажатие клавиши -->
        <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}" Padding="16,12,16,12">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C7;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CostTitleText" Grid.Column="1" Style="{StaticResource GroupTitleStyle}" />
                    <TextBlock x:Name="CatalogLabel" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="CatalogCombo" Grid.Column="3" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0"
                              Background="{StaticResource CardBrush}" SelectionChanged="OnCatalogChanged" />
                    <Button x:Name="LoadPriceButton" Grid.Column="4" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" Click="OnLoadPriceClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                            <TextBlock x:Name="LoadPriceText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TemplateButton" Grid.Column="5" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" Click="OnTemplateClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="12" />
                            <TextBlock x:Name="TemplateText" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PullPriceButton" Grid.Column="6" Height="28" Padding="10,0" CornerRadius="6" FontSize="12" Click="OnPullPriceClick"
                            Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="12" />
                            <TextBlock x:Name="PullPriceText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="PricedRows" Grid.Row="1" Spacing="0" />

                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="CostBreakdownText" FontSize="11" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="CatalogInfoText" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Итог: крупная сумма справа (Apple Wallet) -->
                    <Border Grid.Column="1" CornerRadius="12" Padding="18,8,18,8" Background="{StaticResource AccentSoftBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                            <TextBlock x:Name="CostTotalCaption" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="CostTotalValue" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-20" HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="CostSavedText" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Таблицы по конструкциям -->
        <Grid x:Name="TablesGrid" Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="12">
                <Border Style="{StaticResource GroupCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="ConcreteTitle" Style="{StaticResource GroupTitleStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="ConcreteRows" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GroupCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="GlazingTitle" Style="{StaticResource GroupTitleStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="GlazingRows" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource GroupCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RebarTitle" Style="{StaticResource GroupTitleStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="RebarRows" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GroupCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RolledTitle" Style="{StaticResource GroupTitleStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="RolledRows" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- По свойствам: ведомость по значениям выбранного свойства пользователя — на месте таблиц (сегмент «Свойства» в шапке) -->
        <Border x:Name="ParamCard" Grid.Row="3" Style="{StaticResource GroupCardStyle}" Visibility="Collapsed" VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="10" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8EC;" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ParamTitle" Grid.Column="1" Style="{StaticResource GroupTitleStyle}" />
                    <TextBlock x:Name="ParamGroupLabel" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ParamCombo" Grid.Column="3" HorizontalAlignment="Stretch" Height="28" FontSize="12" CornerRadius="6" BorderThickness="0"
                              Background="{StaticResource CardBrush}" SelectionChanged="OnParamGroupChanged" />
                </Grid>
                <StackPanel x:Name="ParamRows" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="NoteText" Grid.Row="4" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,0,0" />
    </Grid>
</ContentDialog>
