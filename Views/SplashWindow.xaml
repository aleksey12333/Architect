<?xml version="1.0" encoding="utf-8"?>
<!-- Заставка запуска (как у Visual Studio / профессиональных CAD): знак, название и бегущий статус фоновой загрузки на матовом стекле. -->
<Window
    x:Class="AIArchitectStudio.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AIArchitectStudio.Views">

    <Grid x:Name="Root" UseLayoutRounding="True">
        <Grid.Resources>
            <!-- Появление: знак проявляется и вырастает 0.9 → 1.0 за 0.8 с, затем название и строка статуса -->
            <Storyboard x:Key="IntroStoryboard">
                <DoubleAnimation Storyboard.TargetName="LogoHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="GlowHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1.4" />
                <DoubleAnimation Storyboard.TargetName="TitleHost" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TitleShift" Storyboard.TargetProperty="Y" From="10" To="0" BeginTime="0:0:0.25" Duration="0:0:0.6">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="FooterHost" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.5" Duration="0:0:0.5" />
            </Storyboard>
        </Grid.Resources>

        <!-- Мягкое акцентное свечение за знаком -->
        <Ellipse x:Name="GlowHost" Width="380" Height="300" Margin="0,-90,0,0" Opacity="0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#300A84FF" />
                    <GradientStop Offset="0.6" Color="#0E5E5CE6" />
                    <GradientStop Offset="1" Color="#000A84FF" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-24,0,0" Spacing="22">
            <views:AppLogo x:Name="LogoHost" Width="104" Height="104" Opacity="0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <views:AppLogo.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="0.9" ScaleY="0.9" />
                </views:AppLogo.RenderTransform>
            </views:AppLogo>
            <StackPanel x:Name="TitleHost" Spacing="6" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="TitleShift" Y="10" />
                </StackPanel.RenderTransform>
                <TextBlock HorizontalAlignment="Center" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-10"
                           Foreground="{StaticResource TextPrimaryBrush}" Text="Architect Studio Pro" />
                <TextBlock x:Name="TaglineText" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Статус фоновой загрузки и версия -->
        <Grid x:Name="FooterHost" VerticalAlignment="Bottom" Margin="28,0,28,22" Opacity="0" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Opacity="0.7" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" MinHeight="2" CornerRadius="1" Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource TrackBrush}" />
        </Grid>
    </Grid>
</Window>
