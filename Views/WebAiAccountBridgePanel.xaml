<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AIArchitectStudio.Views.WebAiAccountBridgePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource IslandStyle}" Padding="8">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок: сайт (Apple Segmented Control) + обновить + закрыть -->
            <Grid Grid.Row="0" ColumnSpacing="6" Padding="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ChatGptTab" GroupName="WebSite" Style="{StaticResource SegmentRadioStyle}" Tag="WebChatGpt"
                                     Content="ChatGPT" Padding="10,0" FontSize="12" Checked="OnSiteChecked" />
                        <RadioButton x:Name="ClaudeTab" GroupName="WebSite" Style="{StaticResource SegmentRadioStyle}" Tag="WebClaude"
                                     Content="Claude" Padding="10,0" FontSize="12" Checked="OnSiteChecked" />
                        <RadioButton x:Name="GeminiTab" GroupName="WebSite" Style="{StaticResource SegmentRadioStyle}" Tag="WebGemini"
                                     Content="Gemini" Padding="10,0" FontSize="12" Checked="OnSiteChecked" />
                    </StackPanel>
                </Border>
                <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnReloadClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Статус двойного перехватчика -->
            <Border Grid.Row="1" Background="{StaticResource TrackBrush}" CornerRadius="8" Padding="10,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                        <FontIcon x:Name="StatusGlyph" Glyph="&#xE946;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ProgressRing x:Name="StatusRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
            </Border>

            <!-- Действия -->
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="8" Click="OnApplyJsonClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FB;" FontSize="13" />
                        <TextBlock x:Name="ApplyText" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyPromptButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="OnCopyPromptClick">
                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                </Button>
                <Button x:Name="ResendButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Click="OnResendClick">
                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                </Button>
            </Grid>

            <!-- Веб-чат -->
            <Border Grid.Row="3" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource StudioBorderBrush}"
                    Background="{StaticResource CardBrush}">
                <Grid>
                    <WebView2 x:Name="Web" />
                    <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="300">
                        <ProgressRing IsActive="True" Width="24" Height="24" />
                        <TextBlock x:Name="PlaceholderText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ProfileText" Grid.Row="4" FontSize="10" Margin="4,0" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextSecondaryBrush}" IsTextSelectionEnabled="True" />
        </Grid>
    </Border>
</UserControl>
