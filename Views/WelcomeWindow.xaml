<?xml version="1.0" encoding="utf-8"?>
<!-- Стартовое окно 960 × 620 без рамки (Apple / Visual Studio): слева действия и недавние проекты, справа шаблоны-плитки; поверх — онбординг профиля. -->
<Window
    x:Class="AIArchitectStudio.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIArchitectStudio"
    xmlns:views="using:AIArchitectStudio.Views">

    <Grid x:Name="Root" UseLayoutRounding="True" Opacity="0">
        <Grid.Resources>
            <!-- Действие сайдбара: глиф, подпись, подсказка; мягкая подсветка при наведении -->
            <Style x:Key="SidebarActionStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                                <Setter Target="Presenter.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HoverLayer" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Плитка шаблона: превью, название, описание; при наведении — акцентная рамка и лёгкое увеличение -->
            <Style x:Key="TemplateCardStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseLayoutRounding" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="RootScale" />
                                </Grid.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                            <VisualState.Setters>
                                                <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.08" />
                                                <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.99" Duration="0:0:0.08" />
                                            </Storyboard>
                                            <VisualState.Setters>
                                                <Setter Target="HoverBorder.BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Target="HoverLayer.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HoverLayer" Background="{StaticResource HoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                                <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                  Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="HoverBorder" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Карточка профиля онбординга (выбранная — акцентная рамка и подложка, задаётся в коде) -->
            <Style x:Key="ProfileCardStyle" TargetType="Button" BasedOn="{StaticResource TemplateCardStyle}">
                <Setter Property="Padding" Value="18,18,18,16" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <Style x:Key="FeatureTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Основной слой (сайдбар и шаблоны): при онбординге уходит, освобождая стекло окна -->
        <Grid x:Name="MainLayer" Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Сайдбар ═══════════════ -->
        <Border Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="0,0,1,0" />
        <Grid Padding="18,22,14,18" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,0,0,4">
                <views:AppLogo Width="38" Height="38" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Architect Studio Pro" />
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="2">
                <Button x:Name="NewProjectButton" Style="{StaticResource SidebarActionStyle}" Click="OnNewProjectClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{StaticResource OnAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind L.T('WelcomeNew', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('WelcomeNewHint', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SidebarActionStyle}" Click="OnOpenClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource TrackBrush}">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind L.T('WelcomeOpen', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('WelcomeOpenHint', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource SidebarActionStyle}" Click="OnSettingsClick">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource TrackBrush}">
                            <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind L.T('Settings', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('WelcomeSettingsHint', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Недавние проекты -->
            <Grid Grid.Row="2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="10,0,0,0" Text="{x:Bind L.T('WelcomeRecent', L.Language), Mode=OneWay}" />
                <TextBlock x:Name="RecentEmptyText" Grid.Row="1" Margin="10,0,6,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{x:Bind L.T('WelcomeRecentEmpty', L.Language), Mode=OneWay}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:RecentProjectItem">
                                <Button Style="{StaticResource SidebarActionStyle}" Padding="10,6" Tag="{x:Bind Path}" Click="OnRecentClick"
                                        ToolTipService.ToolTip="{x:Bind Path}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="0">
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{x:Bind Name}" />
                                            <TextBlock FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind Folder}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Профиль работы и язык -->
            <StackPanel Grid.Row="3" Spacing="10">
                <Button Style="{StaticResource SidebarActionStyle}" Click="OnProfileClick" Background="{StaticResource TrackBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="ProfileGlyph" FontSize="14" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('ProfileCaption', L.Language), Mode=OneWay}" />
                            <TextBlock x:Name="ProfileTitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Button>
                <Border Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangRu" GroupName="WelcomeLang" Style="{StaticResource SegmentRadioStyle}" Content="RU" MinWidth="44" Checked="OnLanguageChecked" />
                        <RadioButton x:Name="LangEn" GroupName="WelcomeLang" Style="{StaticResource SegmentRadioStyle}" Content="EN" MinWidth="44" Checked="OnLanguageChecked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ Шаблоны ═══════════════ -->
        <Grid x:Name="ContentHost" Grid.Column="1" Padding="32,30,32,28" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="GreetingText" FontSize="28" FontWeight="SemiBold" CharacterSpacing="-10" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Grid.Row="1" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Text="{x:Bind L.T('WelcomeSubtitle', L.Language), Mode=OneWay}" />
            <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
                <!-- Волна 6: восстановление последней рабочей сессии из автосохранения в 1 клик -->
                <Button x:Name="RestoreSessionButton" Style="{StaticResource SidebarActionStyle}" Click="OnRestoreSessionClick" Visibility="Collapsed"
                        Background="{StaticResource TrackBrush}" BorderBrush="{StaticResource StudioBorderBrush}" BorderThickness="1" Padding="12,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <FontIcon Glyph="&#xE81C;" FontSize="13" Foreground="{StaticResource OnAccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind L.T('W6RestoreSession', L.Language), Mode=OneWay}" />
                            <TextBlock x:Name="RestoreSessionText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Button>
                <!-- Волна 6: Среда девелопера, в которой откроется проект (тот же проект доступен во всех трёх) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" Margin="2,0,0,0" Text="{x:Bind L.T('W6EnvCaption', L.Language), Mode=OneWay}" />
                    <Border Grid.Column="1" Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="EnvSiteRadio" GroupName="WelcomeEnv" Style="{StaticResource SegmentRadioStyle}" Tag="site" Checked="OnEnvironmentChecked" MinWidth="120"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvSiteHint', L.Language), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE707;" FontSize="12" /><TextBlock FontSize="12" Text="{x:Bind L.T('W6EnvSiteShort', L.Language), Mode=OneWay}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EnvBuildingRadio" GroupName="WelcomeEnv" Style="{StaticResource SegmentRadioStyle}" Tag="building" Checked="OnEnvironmentChecked" MinWidth="120"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvBuildingHint', L.Language), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" FontSize="12" /><TextBlock FontSize="12" Text="{x:Bind L.T('W6EnvBuildingShort', L.Language), Mode=OneWay}" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="EnvInteriorsRadio" GroupName="WelcomeEnv" Style="{StaticResource SegmentRadioStyle}" Tag="interiors" Checked="OnEnvironmentChecked" MinWidth="120"
                                         ToolTipService.ToolTip="{x:Bind L.T('W6EnvInteriorsHint', L.Language), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8A9;" FontSize="12" /><TextBlock FontSize="12" Text="{x:Bind L.T('W6EnvInteriorsShort', L.Language), Mode=OneWay}" /></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="2,2,0,4" Text="{x:Bind L.T('WelcomeTemplates', L.Language), Mode=OneWay}" />
            </StackPanel>
            <Grid x:Name="TemplateGrid" Grid.Row="3" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
            </Grid>
        </Grid>
        </Grid>

        <!-- Приёмник начального фокуса: без рамки клавиатурного фокуса на первой кнопке при открытии -->
        <ContentControl x:Name="FocusSink" Width="0" Height="0" IsTabStop="True" TabIndex="-1" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <!-- Область перетаскивания окна и кнопки «Свернуть / Закрыть» -->
        <Border x:Name="DragArea" Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" Margin="0,0,128,0" Background="Transparent" />
        <StackPanel x:Name="WindowButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Spacing="2">
            <!-- Волна 6: «Свернуть меню» — компактная стеклянная капсула в углу экрана (сцена за ней видна), разворачивается обратно -->
            <Button x:Name="CollapseMenuButton" Style="{StaticResource IconButtonStyle}" Click="OnCollapseMenuClick"
                    AutomationProperties.Name="{x:Bind L.T('W6CollapseMenu', L.Language), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind L.T('W6CollapseMenu', L.Language), Mode=OneWay}">
                <FontIcon Glyph="&#xE73F;" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="OnMinimizeClick" ToolTipService.ToolTip="{x:Bind L.T('WindowMinimize', L.Language), Mode=OneWay}">
                <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
            </Button>
            <Button Style="{StaticResource IconButtonStyle}" Click="OnCloseClick" ToolTipService.ToolTip="{x:Bind L.T('WindowClose', L.Language), Mode=OneWay}">
                <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
            </Button>
        </StackPanel>

        <!-- ═══════════════ Онбординг-мастер: шаг 1 «Укажите ваш опыт в проектировании», шаг 2 «Выберите необходимые модули» ═══════════════ -->
        <Grid x:Name="OnboardingOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent">
            <Grid x:Name="OnboardingContent" MaxWidth="920" Padding="36,30,36,26" VerticalAlignment="Center" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <views:AppLogo Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <!-- Индикатор шагов мастера: «Шаг 1 из 2» и две точки-капсулы -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border x:Name="StepDot1" Width="18" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}" />
                        <Border x:Name="StepDot2" Width="6" Height="6" CornerRadius="3" Background="{StaticResource StudioBorderBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="StepText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="OnboardingTitleText" Grid.Row="2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" CharacterSpacing="-10"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="OnboardingSubtitleText" Grid.Row="3" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" MaxWidth="640" Margin="0,0,0,18"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- Шаг 2: карточки-чекбоксы модулей (2 × 3, последняя — сводка выбора) -->
                <Grid x:Name="ModuleGrid" Grid.Row="4" ColumnSpacing="12" RowSpacing="12" MaxWidth="760" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                </Grid>

                <Grid x:Name="ProfileCardsGrid" Grid.Row="4" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ProfileBeginnerCard" Grid.Column="0" Style="{StaticResource ProfileCardStyle}" Tag="Beginner" Click="OnProfileCardClick">
                        <StackPanel Spacing="8">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left" Background="#2E30D158">
                                <FontIcon Glyph="&#xE70F;" FontSize="17" Foreground="#30D158" />
                            </Border>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" Text="{x:Bind L.T('ProfileBeginner', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,-4,0,2" Foreground="#30D158" Text="{x:Bind L.T('OnboardingLevelBasic', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('ProfileBeginnerHint', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Text="{x:Bind L.T('ProfileBeginnerFeatures', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProfileArchitectCard" Grid.Column="1" Style="{StaticResource ProfileCardStyle}" Tag="Architect" Click="OnProfileCardClick">
                        <StackPanel Spacing="8">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left" Background="#2E0A84FF">
                                <FontIcon Glyph="&#xE80F;" FontSize="17" Foreground="#0A84FF" />
                            </Border>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" Text="{x:Bind L.T('ProfileArchitect', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,-4,0,2" Foreground="#0A84FF" Text="{x:Bind L.T('OnboardingLevelStandard', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('ProfileArchitectHint', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Text="{x:Bind L.T('ProfileArchitectFeatures', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProfileEngineerCard" Grid.Column="2" Style="{StaticResource ProfileCardStyle}" Tag="StructuralEngineer" Click="OnProfileCardClick">
                        <StackPanel Spacing="8">
                            <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Left" Background="#2EFF9F0A">
                                <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="#FF9F0A" />
                            </Border>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" Text="{x:Bind L.T('ProfileEngineer', L.Language), Mode=OneWay}" />
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,-4,0,2" Foreground="#FF9F0A" Text="{x:Bind L.T('OnboardingLevelAdvanced', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Bind L.T('ProfileEngineerHint', L.Language), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FeatureTextStyle}" Text="{x:Bind L.T('ProfileEngineerFeatures', L.Language), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,22,0,0">
                    <Button x:Name="OnboardingBackButton" CornerRadius="8" MinWidth="120" Height="34" FontSize="13" Visibility="Collapsed"
                            Background="{StaticResource TrackBrush}" BorderThickness="0"
                            Click="OnOnboardingBackClick" Content="{x:Bind L.T('OnboardingBack', L.Language), Mode=OneWay}" />
                    <Button x:Name="OnboardingContinueButton" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" MinWidth="180" Height="34" FontSize="13"
                            Click="OnOnboardingContinueClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══════════════ Волна 6: свёрнутое меню — стеклянная капсула в углу экрана ═══════════════ -->
        <Grid x:Name="CapsuleLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Padding="12,0,10,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <views:AppLogo Width="28" Height="28" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Architect Studio Pro" />
                <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Text="{x:Bind L.T('W6CapsuleHint', L.Language), Mode=OneWay}" />
            </StackPanel>
            <Button x:Name="ExpandMenuButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" CornerRadius="14" Height="28" Padding="12,0" FontSize="12"
                    VerticalAlignment="Center" Click="OnExpandMenuClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE740;" FontSize="11" />
                    <TextBlock Text="{x:Bind L.T('W6ExpandMenu', L.Language), Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" Click="OnMinimizeClick"
                    ToolTipService.ToolTip="{x:Bind L.T('WindowMinimize', L.Language), Mode=OneWay}">
                <FontIcon Glyph="&#xE921;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</Window>
